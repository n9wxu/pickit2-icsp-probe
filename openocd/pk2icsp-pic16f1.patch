diff --git a/tcl/interface/pk2icsp.cfg b/tcl/interface/pk2icsp.cfg
new file mode 100644
index 0000000..bfd3e08
--- /dev/null
+++ b/tcl/interface/pk2icsp.cfg
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+#
+# PICkit 2 running the ICSP probe firmware (USB 04D8:0033, vendor interface),
+# for PIC16F1 targets. Only the icsp transport is available.
+#
+# Settings, to be changed in a board script or before "init":
+#   pk2icsp vdd 3000        target VDD in mV (default 3000, at most 5000;
+#                           mind the maximum of the target: 3600 for PIC16LF)
+#   pk2icsp power on|off    off: the target has its own supply
+#   pk2icsp hvp on|off      high voltage entry of programming mode (default
+#                           off, the low voltage key; the target needs LVP
+#                           enabled and MCLR assigned for it)
+#   pk2icsp vpp 8500        VPP in mV for high voltage entry
+#   pk2icsp power_off_on_quit on|off   switch the target off when OpenOCD exits
+#
+
+adapter driver pk2icsp
+
+# the speed is fixed by the probe
+adapter speed 100
diff --git a/tcl/target/pic16f193x.cfg b/tcl/target/pic16f193x.cfg
new file mode 100644
index 0000000..4f18859
--- /dev/null
+++ b/tcl/target/pic16f193x.cfg
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+#
+# Microchip PIC16(L)F193x (PIC16F1933/34/36/37/38/39 and the LF versions)
+# with the on-chip debug executive, through the PICkit 2 ICSP probe.
+#
+# Address convention: code addresses are byte addresses as in HEX files
+# (2 * word address), program flash at 0; data memory is at 0x800000 + the
+# data address (register file 0x000-0xFFF, linear 0x2000 and up).
+#
+# Variables: CHIPNAME. The flash banks are sized by the probe.
+#
+
+transport select icsp
+
+if { [info exists CHIPNAME] } {
+   set _CHIPNAME $CHIPNAME
+} else {
+   set _CHIPNAME pic16f193x
+}
+
+icsp newtap $_CHIPNAME cpu
+
+set _TARGETNAME $_CHIPNAME.cpu
+target create $_TARGETNAME pic16f1 -chain-position $_CHIPNAME.cpu
+
+# One bank per memory, selected by the base (HEX file byte address). Erasing
+# the program flash bank is a bulk erase of the whole device.
+flash bank $_CHIPNAME.flash  pic16f1 0x00000 0 0 0 $_TARGETNAME
+flash bank $_CHIPNAME.config pic16f1 0x10000 0 0 0 $_TARGETNAME
+flash bank $_CHIPNAME.eeprom pic16f1 0x1E000 0 0 0 $_TARGETNAME
+
+# Only one hardware breakpoint exists, which halts after the instruction.
+# Make gdb's software breakpoint requests use it.
+gdb_breakpoint_override hard
+
+# There is no srst; reset is done by the target driver
+reset_config none
