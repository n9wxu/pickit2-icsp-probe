diff --git a/src/jtag/drivers/pk2icsp.c b/src/jtag/drivers/pk2icsp.c
new file mode 100644
index 0000000..75341cc
--- /dev/null
+++ b/src/jtag/drivers/pk2icsp.c
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+/*
+ * Adapter driver for the PICkit 2 ICSP probe firmware (USB 04D8:0033,
+ * vendor specific interface, bulk endpoints 0x01 and 0x81).
+ *
+ * The probe executes batches of operations carried in one 64 byte packet
+ * and answers each packet with exactly one packet; the protocol is
+ * documented in docs/protocol.md of the probe project.  This driver only
+ * moves packets; the operation queue and the higher level functions are in
+ * jtag/icsp.c.
+ *
+ * The probe firmware has the same VID:PID as the stock PICkit 2 (HID), so
+ * the interface class is checked.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <jtag/interface.h>
+#include <jtag/icsp.h>
+#include <helper/command.h>
+#include <helper/log.h>
+#include "libusb_helper.h"
+
+#define PK2_VID  0x04D8
+#define PK2_PID  0x0033
+#define PK2_PKT  64
+
+#define PK2_CAP_GEN6 0x04
+#define PK2_CAP_ICD  0x10
+
+static struct icsp_config pk2_config = {
+	.vdd_mv = 3000,
+	.vpp_mv = 8500,
+	.power = true,
+	.hvp = false,
+	.power_off_on_quit = false,
+};
+
+static struct libusb_device_handle *pk2_dev;
+static unsigned int pk2_ep_in, pk2_ep_out;
+
+static const char *pk2_error_name(uint8_t code)
+{
+	switch (code) {
+	case 1: return "unknown operation";
+	case 2: return "operation runs past the end of the packet";
+	case 3: return "reply does not fit in one packet";
+	case 4: return "argument out of range";
+	case 5: return "debug executive did not respond";
+	case 6: return "VDD or VPP fault, target power was switched off";
+	default: return "unknown error";
+	}
+}
+
+static int pk2_transact(const uint8_t *req, size_t req_len,
+		uint8_t *reply, size_t *reply_len, uint8_t *status)
+{
+	uint8_t buf[PK2_PKT];
+	int transferred = 0;
+
+	*status = 0;
+	*reply_len = 0;
+	if (!pk2_dev || req_len == 0 || req_len > PK2_PKT)
+		return ERROR_FAIL;
+
+	memcpy(buf, req, req_len);
+	int r = jtag_libusb_bulk_write(pk2_dev, pk2_ep_out, (char *)buf, req_len, 2000, &transferred);
+	if (r != 0 || (size_t)transferred != req_len) {
+		LOG_ERROR("pk2icsp: USB write failed (%d)", r);
+		return ERROR_FAIL;
+	}
+	r = jtag_libusb_bulk_read(pk2_dev, pk2_ep_in, (char *)buf, PK2_PKT, 10000, &transferred);
+	if (r != 0 || transferred < 2) {
+		LOG_ERROR("pk2icsp: USB read failed (%d, %d bytes)", r, transferred);
+		return ERROR_FAIL;
+	}
+	if (buf[0]) {
+		*status = buf[0];
+		/* A debug executive timeout is an expected outcome while probing */
+		if (buf[0] == ICSP_ERR_TIMEOUT)
+			LOG_DEBUG("pk2icsp: %s (operation at offset %u)", pk2_error_name(buf[0]), buf[1]);
+		else
+			LOG_ERROR("pk2icsp: %s (operation at offset %u)", pk2_error_name(buf[0]), buf[1]);
+		return ERROR_FAIL;
+	}
+	memcpy(reply, buf + 2, transferred - 2);
+	*reply_len = transferred - 2;
+	return ERROR_OK;
+}
+
+static const struct icsp_driver pk2_icsp_ops = {
+	.transact = pk2_transact,
+	.config = &pk2_config,
+};
+
+static int pk2_init(void)
+{
+	const uint16_t vids[] = { PK2_VID, 0 };
+	const uint16_t pids[] = { PK2_PID, 0 };
+
+	if (jtag_libusb_open(vids, pids, &pk2_dev, NULL) != ERROR_OK) {
+		LOG_ERROR("pk2icsp: cannot open USB device %04x:%04x", PK2_VID, PK2_PID);
+		return ERROR_JTAG_INIT_FAILED;
+	}
+	if (jtag_libusb_choose_interface(pk2_dev, &pk2_ep_in, &pk2_ep_out, 0xFF, -1, -1,
+			LIBUSB_TRANSFER_TYPE_BULK) != ERROR_OK) {
+		LOG_ERROR("pk2icsp: no vendor specific bulk interface; is the probe firmware loaded "
+			"(not the stock PICkit 2 firmware or its bootloader)?");
+		jtag_libusb_close(pk2_dev);
+		pk2_dev = NULL;
+		return ERROR_JTAG_INIT_FAILED;
+	}
+
+	uint8_t info[8];
+	const uint8_t op_info[] = { ICSP_OP_INFO };
+	if (icsp_run(op_info, sizeof(op_info), info, sizeof(info)) != ERROR_OK ||
+			memcmp(info, "PK2P", 4) != 0) {
+		LOG_ERROR("pk2icsp: the device does not answer like the probe firmware");
+		jtag_libusb_close(pk2_dev);
+		pk2_dev = NULL;
+		return ERROR_JTAG_INIT_FAILED;
+	}
+	LOG_INFO("pk2icsp: probe firmware %u.%u, protocol %u, capabilities 0x%02x",
+		info[4], info[5], info[6], info[7]);
+	if (!(info[7] & PK2_CAP_GEN6) || !(info[7] & PK2_CAP_ICD))
+		LOG_WARNING("pk2icsp: probe lacks 6 bit command or debug link support");
+
+	if (pk2_config.power) {
+		if (icsp_power_on() != ERROR_OK) {
+			jtag_libusb_close(pk2_dev);
+			pk2_dev = NULL;
+			return ERROR_JTAG_INIT_FAILED;
+		}
+	} else {
+		LOG_INFO("pk2icsp: target is self-powered, the probe does not supply VDD");
+	}
+	return ERROR_OK;
+}
+
+static int pk2_quit(void)
+{
+	if (!pk2_dev)
+		return ERROR_OK;
+
+	/* Leave the pins released. Target power stays on, so that a debug
+	 * session survives and can be re-attached, unless configured. */
+	icsp_release();
+	if (pk2_config.power && pk2_config.power_off_on_quit)
+		icsp_power_off();
+
+	jtag_libusb_close(pk2_dev);
+	pk2_dev = NULL;
+	return ERROR_OK;
+}
+
+COMMAND_HANDLER(pk2_handle_vdd_command)
+{
+	if (CMD_ARGC == 0) {
+		command_print(CMD, "%u", pk2_config.vdd_mv);
+		return ERROR_OK;
+	}
+	if (CMD_ARGC != 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	unsigned int mv;
+	COMMAND_PARSE_NUMBER(uint, CMD_ARGV[0], mv);
+	if (mv > ICSP_VDD_MAX_MV || mv < 1800) {
+		command_print(CMD, "pk2icsp: VDD must be 1800 to %u mV", ICSP_VDD_MAX_MV);
+		return ERROR_COMMAND_ARGUMENT_INVALID;
+	}
+	pk2_config.vdd_mv = mv;
+	if (pk2_dev && pk2_config.power) {
+		LOG_INFO("pk2icsp: new VDD applies the next time the target is powered");
+	}
+	return ERROR_OK;
+}
+
+COMMAND_HANDLER(pk2_handle_vpp_command)
+{
+	if (CMD_ARGC == 0) {
+		command_print(CMD, "%u", pk2_config.vpp_mv);
+		return ERROR_OK;
+	}
+	if (CMD_ARGC != 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	unsigned int mv;
+	COMMAND_PARSE_NUMBER(uint, CMD_ARGV[0], mv);
+	if (mv < 5000 || mv > 13000) {
+		command_print(CMD, "pk2icsp: VPP must be 5000 to 13000 mV");
+		return ERROR_COMMAND_ARGUMENT_INVALID;
+	}
+	pk2_config.vpp_mv = mv;
+	return ERROR_OK;
+}
+
+static int pk2_bool_command(struct command_invocation *cmd, bool *flag)
+{
+	if (CMD_ARGC == 0) {
+		command_print(cmd, "%s", *flag ? "on" : "off");
+		return ERROR_OK;
+	}
+	if (CMD_ARGC != 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	if (!strcmp(CMD_ARGV[0], "on") || !strcmp(CMD_ARGV[0], "1"))
+		*flag = true;
+	else if (!strcmp(CMD_ARGV[0], "off") || !strcmp(CMD_ARGV[0], "0"))
+		*flag = false;
+	else
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	return ERROR_OK;
+}
+
+COMMAND_HANDLER(pk2_handle_power_command)
+{
+	return pk2_bool_command(CMD, &pk2_config.power);
+}
+
+COMMAND_HANDLER(pk2_handle_hvp_command)
+{
+	return pk2_bool_command(CMD, &pk2_config.hvp);
+}
+
+COMMAND_HANDLER(pk2_handle_power_off_on_quit_command)
+{
+	return pk2_bool_command(CMD, &pk2_config.power_off_on_quit);
+}
+
+COMMAND_HANDLER(pk2_handle_status_command)
+{
+	struct icsp_status st;
+
+	if (!pk2_dev) {
+		command_print(CMD, "pk2icsp: not initialised");
+		return ERROR_FAIL;
+	}
+	int retval = icsp_get_status(&st);
+	if (retval != ERROR_OK)
+		return retval;
+	command_print(CMD, "VDD %u mV, VPP rail %u mV, flags 0x%02x%s%s%s%s%s",
+		st.vdd_mv, st.vpp_mv, st.flags,
+		(st.flags & ICSP_ST_VDD_ON) ? " vdd-on" : "",
+		(st.flags & ICSP_ST_VPP_SWITCH) ? " vpp-on-mclr" : "",
+		(st.flags & ICSP_ST_MCLR_GND) ? " mclr-grounded" : "",
+		(st.flags & ICSP_ST_VDD_FAULT) ? " VDD-FAULT" : "",
+		(st.flags & ICSP_ST_VPP_FAULT) ? " VPP-FAULT" : "");
+	return ERROR_OK;
+}
+
+static const struct command_registration pk2_subcommand_handlers[] = {
+	{
+		.name = "vdd",
+		.handler = pk2_handle_vdd_command,
+		.mode = COMMAND_ANY,
+		.help = "set or show the target VDD setpoint in mV (1800-5000, default 3000)",
+		.usage = "[mV]",
+	},
+	{
+		.name = "vpp",
+		.handler = pk2_handle_vpp_command,
+		.mode = COMMAND_ANY,
+		.help = "set or show VPP in mV used for high voltage entry (default 8500)",
+		.usage = "[mV]",
+	},
+	{
+		.name = "power",
+		.handler = pk2_handle_power_command,
+		.mode = COMMAND_ANY,
+		.help = "whether the probe supplies the target (default on)",
+		.usage = "[on|off]",
+	},
+	{
+		.name = "hvp",
+		.handler = pk2_handle_hvp_command,
+		.mode = COMMAND_ANY,
+		.help = "enter programming mode with VPP on MCLR instead of the low voltage key (default off)",
+		.usage = "[on|off]",
+	},
+	{
+		.name = "power_off_on_quit",
+		.handler = pk2_handle_power_off_on_quit_command,
+		.mode = COMMAND_ANY,
+		.help = "switch target power off when OpenOCD exits (default off)",
+		.usage = "[on|off]",
+	},
+	{
+		.name = "status",
+		.handler = pk2_handle_status_command,
+		.mode = COMMAND_EXEC,
+		.help = "show the probe's power flags and voltages",
+		.usage = "",
+	},
+	COMMAND_REGISTRATION_DONE
+};
+
+static const struct command_registration pk2_command_handlers[] = {
+	{
+		.name = "pk2icsp",
+		.mode = COMMAND_ANY,
+		.help = "PICkit 2 ICSP probe commands",
+		.usage = "",
+		.chain = pk2_subcommand_handlers,
+	},
+	COMMAND_REGISTRATION_DONE
+};
+
+static const char * const pk2_transports[] = { "icsp", NULL };
+
+struct adapter_driver pk2icsp_adapter_driver = {
+	.name = "pk2icsp",
+	.transports = pk2_transports,
+	.commands = pk2_command_handlers,
+
+	.init = pk2_init,
+	.quit = pk2_quit,
+
+	.icsp_ops = &pk2_icsp_ops,
+};
diff --git a/src/jtag/icsp.c b/src/jtag/icsp.c
new file mode 100644
index 0000000..b8d7142
--- /dev/null
+++ b/src/jtag/icsp.c
@@ -0,0 +1,575 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+/*
+ * ICSP transport for Microchip PIC16F1 devices, see icsp.h.
+ *
+ * Besides registering the "icsp" transport this file turns the raw
+ * request/reply exchange the adapter driver provides into the operations
+ * the flash and target drivers need.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "interface.h"
+#include "icsp.h"
+#include <helper/command.h>
+#include <helper/log.h>
+#include <helper/time_support.h>
+#include <transport/transport.h>
+
+extern struct adapter_driver *adapter_driver;
+
+#define PKT_SIZE        64
+#define REPLY_DATA_MAX  (PKT_SIZE - 2)
+
+struct queued_op {
+	size_t offset;
+	size_t len;
+	size_t reply_len;
+};
+
+static uint8_t *q_data;
+static size_t q_data_len, q_data_cap;
+static struct queued_op *q_ops;
+static size_t q_num_ops, q_ops_cap;
+static uint8_t last_status;
+
+static const struct icsp_driver *drv(void)
+{
+	return adapter_driver ? adapter_driver->icsp_ops : NULL;
+}
+
+const struct icsp_config *icsp_get_config(void)
+{
+	return drv() ? drv()->config : NULL;
+}
+
+uint8_t icsp_last_status(void)
+{
+	return last_status;
+}
+
+void icsp_queue_clear(void)
+{
+	q_data_len = 0;
+	q_num_ops = 0;
+}
+
+int icsp_queue(const uint8_t *op, size_t len, size_t reply_len)
+{
+	if (len == 0 || len > PKT_SIZE || reply_len > REPLY_DATA_MAX) {
+		LOG_ERROR("icsp: bad operation size");
+		return ERROR_FAIL;
+	}
+
+	if (q_data_len + len > q_data_cap) {
+		size_t cap = q_data_cap ? q_data_cap * 2 : 4096;
+		while (cap < q_data_len + len)
+			cap *= 2;
+		uint8_t *n = realloc(q_data, cap);
+		if (!n)
+			return ERROR_FAIL;
+		q_data = n;
+		q_data_cap = cap;
+	}
+	if (q_num_ops + 1 > q_ops_cap) {
+		size_t cap = q_ops_cap ? q_ops_cap * 2 : 512;
+		struct queued_op *n = realloc(q_ops, cap * sizeof(*n));
+		if (!n)
+			return ERROR_FAIL;
+		q_ops = n;
+		q_ops_cap = cap;
+	}
+
+	memcpy(q_data + q_data_len, op, len);
+	q_ops[q_num_ops].offset = q_data_len;
+	q_ops[q_num_ops].len = len;
+	q_ops[q_num_ops].reply_len = reply_len;
+	q_num_ops++;
+	q_data_len += len;
+	return ERROR_OK;
+}
+
+static int transact(const uint8_t *req, size_t req_len, uint8_t *out, size_t *out_len)
+{
+	const struct icsp_driver *d = drv();
+	uint8_t reply[PKT_SIZE];
+	size_t rlen = 0;
+	uint8_t status = 0;
+
+	if (!d) {
+		LOG_ERROR("icsp: no adapter");
+		return ERROR_FAIL;
+	}
+	int retval = d->transact(req, req_len, reply, &rlen, &status);
+	last_status = status;
+	if (retval != ERROR_OK)
+		return retval;
+	memcpy(out, reply, rlen);
+	*out_len = rlen;
+	return ERROR_OK;
+}
+
+int icsp_flush(uint8_t *out, size_t out_size)
+{
+	uint8_t req[PKT_SIZE];
+	uint8_t reply[PKT_SIZE];
+	size_t req_len = 0, rlen_expected = 0, total = 0;
+	int retval = ERROR_OK;
+
+	last_status = 0;
+
+	for (size_t i = 0; i <= q_num_ops && retval == ERROR_OK; i++) {
+		bool last = (i == q_num_ops);
+		if (!last) {
+			struct queued_op *o = &q_ops[i];
+			if (req_len + o->len <= PKT_SIZE &&
+					rlen_expected + o->reply_len <= REPLY_DATA_MAX) {
+				memcpy(req + req_len, q_data + o->offset, o->len);
+				req_len += o->len;
+				rlen_expected += o->reply_len;
+				continue;
+			}
+		}
+		if (req_len) {
+			size_t got = 0;
+			retval = transact(req, req_len, reply, &got);
+			if (retval == ERROR_OK) {
+				if (got != rlen_expected) {
+					LOG_ERROR("icsp: probe returned %zu data bytes, expected %zu",
+						got, rlen_expected);
+					retval = ERROR_FAIL;
+				} else if (out) {
+					if (total + got > out_size) {
+						LOG_ERROR("icsp: reply buffer too small");
+						retval = ERROR_FAIL;
+					} else {
+						memcpy(out + total, reply, got);
+					}
+				}
+				total += got;
+			}
+		}
+		req_len = 0;
+		rlen_expected = 0;
+		if (!last && retval == ERROR_OK) {
+			struct queued_op *o = &q_ops[i];
+			memcpy(req, q_data + o->offset, o->len);
+			req_len = o->len;
+			rlen_expected = o->reply_len;
+		}
+	}
+
+	icsp_queue_clear();
+	return retval;
+}
+
+int icsp_run(const uint8_t *op, size_t len, uint8_t *reply, size_t reply_len)
+{
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = icsp_queue(op, len, reply_len);
+	if (retval != ERROR_OK)
+		return retval;
+	return icsp_flush(reply, reply_len);
+}
+
+/* ---- Queued helpers ----------------------------------------------------- */
+
+#define QUEUE(...) \
+	do { \
+		const uint8_t op_[] = { __VA_ARGS__ }; \
+		return icsp_queue(op_, sizeof(op_), 0); \
+	} while (0)
+
+int icsp_set_vdd(unsigned int mv)
+{
+	const struct icsp_config *c = icsp_get_config();
+	unsigned int max = c ? ICSP_VDD_MAX_MV : 0;
+
+	if (mv > max) {
+		LOG_ERROR("icsp: refusing VDD of %u mV (limit %u mV)", mv, max);
+		return ERROR_FAIL;
+	}
+	QUEUE(ICSP_OP_SET_VDD, mv & 0xFF, mv >> 8);
+}
+
+int icsp_vdd_mode(unsigned int mode)
+{
+	QUEUE(ICSP_OP_VDD_MODE, mode);
+}
+
+int icsp_set_vpp(unsigned int mv)
+{
+	if (mv > 13000) {
+		LOG_ERROR("icsp: refusing VPP of %u mV", mv);
+		return ERROR_FAIL;
+	}
+	QUEUE(ICSP_OP_SET_VPP, mv & 0xFF, mv >> 8);
+}
+
+int icsp_mclr(unsigned int mode)
+{
+	QUEUE(ICSP_OP_MCLR, mode);
+}
+
+int icsp_pins(uint8_t pins)
+{
+	const uint8_t op[] = { ICSP_OP_PINS, pins };
+	return icsp_queue(op, sizeof(op), 1);
+}
+
+int icsp_delay_us(unsigned int us)
+{
+	while (us) {
+		unsigned int n = us > 0xFFFF ? 0xFFFF : us;
+		const uint8_t op[] = { ICSP_OP_DELAY_US, n & 0xFF, n >> 8 };
+		int retval = icsp_queue(op, sizeof(op), 0);
+		if (retval != ERROR_OK)
+			return retval;
+		us -= n;
+	}
+	return ERROR_OK;
+}
+
+int icsp_delay_ms(unsigned int ms)
+{
+	while (ms) {
+		unsigned int n = ms > 100 ? 100 : ms;
+		const uint8_t op[] = { ICSP_OP_DELAY_MS, n };
+		int retval = icsp_queue(op, sizeof(op), 0);
+		if (retval != ERROR_OK)
+			return retval;
+		ms -= n;
+	}
+	return ERROR_OK;
+}
+
+int icsp_led(bool on)
+{
+	QUEUE(ICSP_OP_LED, on ? 1 : 0);
+}
+
+int icsp_clear_faults(void)
+{
+	QUEUE(ICSP_OP_CLEAR_FAULTS);
+}
+
+/* ---- Immediate helpers --------------------------------------------------- */
+
+int icsp_get_status(struct icsp_status *st)
+{
+	uint8_t r[2];
+	uint8_t v[8];
+	const uint8_t op_status[] = { ICSP_OP_STATUS };
+	const uint8_t op_volt[] = { ICSP_OP_READ_VOLT };
+
+	int retval = icsp_run(op_status, sizeof(op_status), r, sizeof(r));
+	if (retval != ERROR_OK)
+		return retval;
+	retval = icsp_run(op_volt, sizeof(op_volt), v, sizeof(v));
+	if (retval != ERROR_OK)
+		return retval;
+	st->flags = r[0];
+	st->pins = r[1];
+	st->vdd_mv = v[0] | (v[1] << 8);
+	st->vpp_mv = v[2] | (v[3] << 8);
+	return ERROR_OK;
+}
+
+int icsp_wait_vpp(unsigned int mv, unsigned int timeout_ms)
+{
+	int64_t end = timeval_ms() + timeout_ms;
+	struct icsp_status st;
+
+	for (;;) {
+		int retval = icsp_get_status(&st);
+		if (retval != ERROR_OK)
+			return retval;
+		if (st.vpp_mv + 400 >= mv)
+			return ERROR_OK;
+		if (timeval_ms() > end) {
+			LOG_ERROR("icsp: VPP only reached %u mV, wanted %u mV", st.vpp_mv, mv);
+			return ERROR_FAIL;
+		}
+		alive_sleep(10);
+	}
+}
+
+int icsp_release(void)
+{
+	int retval = icsp_pins(ICSP_PINS_IDLE);
+	if (retval == ERROR_OK)
+		retval = icsp_mclr(ICSP_MCLR_RELEASE);
+	if (retval == ERROR_OK)
+		retval = icsp_set_vpp(0);
+	if (retval == ERROR_OK)
+		retval = icsp_led(false);
+	if (retval != ERROR_OK) {
+		icsp_queue_clear();
+		return retval;
+	}
+	return icsp_flush(NULL, 0);
+}
+
+int icsp_power_on(void)
+{
+	const struct icsp_config *c = icsp_get_config();
+	struct icsp_status st;
+
+	if (!c || !c->power)
+		return ERROR_OK;
+	int retval = icsp_get_status(&st);
+	if (retval != ERROR_OK)
+		return retval;
+	if (st.flags & ICSP_ST_VDD_ON) {
+		LOG_INFO("icsp: target power is already on (VDD %u mV)", st.vdd_mv);
+		return ERROR_OK;
+	}
+	if (icsp_clear_faults() != ERROR_OK || icsp_set_vdd(c->vdd_mv) != ERROR_OK) {
+		icsp_queue_clear();
+		return ERROR_FAIL;
+	}
+	icsp_pins(ICSP_PINS_IDLE);
+	icsp_mclr(ICSP_MCLR_RELEASE);
+	icsp_vdd_mode(ICSP_VDD_ON);
+	icsp_delay_ms(100);
+	retval = icsp_flush(NULL, 0);
+	if (retval == ERROR_OK && icsp_get_status(&st) == ERROR_OK)
+		LOG_INFO("icsp: target VDD %u mV", st.vdd_mv);
+	return retval;
+}
+
+int icsp_power_off(void)
+{
+	icsp_pins(ICSP_PINS_IDLE);
+	icsp_mclr(ICSP_MCLR_RELEASE);
+	icsp_set_vpp(0);
+	icsp_vdd_mode(ICSP_VDD_DISCHARGE);
+	icsp_delay_ms(50);
+	icsp_vdd_mode(ICSP_VDD_OFF);
+	return icsp_flush(NULL, 0);
+}
+
+int icsp_enter_programming(void)
+{
+	const struct icsp_config *c = icsp_get_config();
+	const uint8_t key[] = { ICSP_OP_KEY, 0 /* LSB first */, 'P', 'H', 'C', 'M', 1 };
+	int retval;
+
+	if (!c)
+		return ERROR_FAIL;
+
+	icsp_clear_faults();
+	icsp_led(true);
+	icsp_pins(ICSP_PINS_LOW);
+	icsp_mclr(ICSP_MCLR_GROUND);
+	if (c->power)
+		icsp_set_vdd(c->vdd_mv);
+	retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+
+	if (c->hvp) {
+		icsp_set_vpp(c->vpp_mv);
+		retval = icsp_flush(NULL, 0);
+		if (retval == ERROR_OK)
+			retval = icsp_wait_vpp(c->vpp_mv, 1000);
+		if (retval != ERROR_OK)
+			goto fail;
+		if (c->power) {
+			/* VPP first, so entry works whatever the configuration
+			 * words say about MCLR and the oscillator. */
+			icsp_vdd_mode(ICSP_VDD_DISCHARGE);
+			icsp_delay_ms(50);
+			icsp_vdd_mode(ICSP_VDD_OFF);
+			icsp_mclr(ICSP_MCLR_VPP);
+			icsp_delay_us(200);
+			icsp_vdd_mode(ICSP_VDD_ON);
+			icsp_delay_ms(10);
+		} else {
+			icsp_delay_ms(5);
+			icsp_mclr(ICSP_MCLR_VPP);
+			icsp_delay_ms(5);
+		}
+	} else {
+		if (c->power) {
+			icsp_vdd_mode(ICSP_VDD_ON);
+			icsp_delay_ms(20);
+		}
+		icsp_mclr(ICSP_MCLR_RELEASE);
+		icsp_delay_ms(2);
+		icsp_mclr(ICSP_MCLR_GROUND);
+		icsp_delay_ms(2);
+		icsp_queue(key, sizeof(key), 0);
+		icsp_delay_ms(2);
+	}
+	retval = icsp_flush(NULL, 0);
+	if (retval == ERROR_OK)
+		return ERROR_OK;
+fail:
+	icsp_queue_clear();
+	icsp_exit_programming(false);
+	return retval;
+}
+
+int icsp_exit_programming(bool keep_power)
+{
+	const struct icsp_config *c = icsp_get_config();
+
+	icsp_mclr(ICSP_MCLR_GROUND);
+	icsp_delay_ms(2);
+	icsp_set_vpp(0);
+	icsp_pins(ICSP_PINS_IDLE);
+	if (c && c->power && !keep_power) {
+		icsp_vdd_mode(ICSP_VDD_DISCHARGE);
+		icsp_delay_ms(50);
+		icsp_vdd_mode(ICSP_VDD_OFF);
+	}
+	icsp_mclr(ICSP_MCLR_RELEASE);
+	icsp_led(false);
+	return icsp_flush(NULL, 0);
+}
+
+/* ---- Debug executive link ------------------------------------------------ */
+
+int icsp_icd_ready(bool *ready)
+{
+	uint8_t r;
+	const uint8_t op[] = { ICSP_OP_ICD_READY };
+	int retval = icsp_run(op, sizeof(op), &r, 1);
+
+	if (retval == ERROR_OK)
+		*ready = r != 0;
+	return retval;
+}
+
+int icsp_icd_queue(const uint8_t *tx, size_t tx_len, size_t rx_len)
+{
+	uint8_t op[PKT_SIZE];
+	int retval;
+
+	if (tx_len > 60)
+		return ERROR_FAIL;
+	if (tx_len) {
+		op[0] = ICSP_OP_ICD_TX;
+		op[1] = 50;                 /* 500 ms */
+		op[2] = tx_len;
+		memcpy(op + 3, tx, tx_len);
+		retval = icsp_queue(op, 3 + tx_len, 0);
+		if (retval != ERROR_OK)
+			return retval;
+	}
+	if (rx_len) {
+		const uint8_t rx[] = { ICSP_OP_ICD_RX, 50, rx_len };
+		return icsp_queue(rx, sizeof(rx), rx_len);
+	}
+	return ERROR_OK;
+}
+
+int icsp_icd_xfer(const uint8_t *tx, size_t tx_len, uint8_t *rx, size_t rx_len)
+{
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = icsp_icd_queue(tx, tx_len, rx_len);
+	if (retval != ERROR_OK)
+		return retval;
+	return icsp_flush(rx, rx_len);
+}
+
+/* ---- Transport ------------------------------------------------------------ */
+
+COMMAND_HANDLER(handle_icsp_newtap_command)
+{
+	struct jtag_tap *tap;
+
+	/* A pseudo TAP, so that targets have a chain position to refer to,
+	 * as with the SWIM transport. */
+	if (CMD_ARGC < 2)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	tap = calloc(1, sizeof(*tap));
+	if (!tap) {
+		LOG_ERROR("Out of memory");
+		return ERROR_FAIL;
+	}
+
+	tap->chip = strdup(CMD_ARGV[0]);
+	tap->tapname = strdup(CMD_ARGV[1]);
+	tap->dotted_name = alloc_printf("%s.%s", CMD_ARGV[0], CMD_ARGV[1]);
+	if (!tap->chip || !tap->tapname || !tap->dotted_name) {
+		LOG_ERROR("Out of memory");
+		free(tap->dotted_name);
+		free(tap->tapname);
+		free(tap->chip);
+		free(tap);
+		return ERROR_FAIL;
+	}
+
+	LOG_DEBUG("Creating new ICSP \"tap\", Chip: %s, Tap: %s, Dotted: %s",
+		tap->chip, tap->tapname, tap->dotted_name);
+
+	tap->enabled = true;
+	jtag_tap_init(tap);
+	return ERROR_OK;
+}
+
+static const struct command_registration icsp_transport_subcommand_handlers[] = {
+	{
+		.name = "newtap",
+		.handler = handle_icsp_newtap_command,
+		.mode = COMMAND_CONFIG,
+		.help = "Create a new pseudo TAP instance named basename.tap_type, "
+			"to attach a target to.",
+		.usage = "basename tap_type",
+	},
+	COMMAND_REGISTRATION_DONE
+};
+
+static const struct command_registration icsp_transport_command_handlers[] = {
+	{
+		.name = "icsp",
+		.mode = COMMAND_ANY,
+		.help = "perform icsp adapter actions",
+		.usage = "",
+		.chain = icsp_transport_subcommand_handlers,
+	},
+	COMMAND_REGISTRATION_DONE
+};
+
+static int icsp_transport_select(struct command_context *cmd_ctx)
+{
+	LOG_DEBUG(__func__);
+	return register_commands(cmd_ctx, NULL, icsp_transport_command_handlers);
+}
+
+static int icsp_transport_init(struct command_context *cmd_ctx)
+{
+	LOG_DEBUG(__func__);
+	if (!drv()) {
+		LOG_ERROR("the adapter does not implement the icsp transport");
+		return ERROR_FAIL;
+	}
+	return ERROR_OK;
+}
+
+static struct transport icsp_transport = {
+	.name = "icsp",
+	.select = icsp_transport_select,
+	.init = icsp_transport_init,
+};
+
+static void icsp_constructor(void) __attribute__ ((constructor));
+static void icsp_constructor(void)
+{
+	transport_register(&icsp_transport);
+}
+
+bool transport_is_icsp(void)
+{
+	return get_current_transport() == &icsp_transport;
+}
diff --git a/src/jtag/icsp.h b/src/jtag/icsp.h
new file mode 100644
index 0000000..96cf4bd
--- /dev/null
+++ b/src/jtag/icsp.h
@@ -0,0 +1,197 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/*
+ * ICSP transport: in-circuit serial programming of Microchip PIC16F1
+ * devices through a probe that executes batches of ICSP operations.
+ *
+ * The adapter driver (see drivers/pk2icsp.c) only has to move one request
+ * packet to the probe and bring the reply back.  Everything else, the
+ * queueing of operations, power and pin control, programming mode entry and
+ * the debug-executive link, is implemented here on top of that, using the
+ * operation set of the PICkit 2 ICSP probe (docs/protocol.md of the probe
+ * project, firmware/proto.h).
+ */
+
+#ifndef OPENOCD_JTAG_ICSP_H
+#define OPENOCD_JTAG_ICSP_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+/* Probe operations (firmware/proto.h) */
+#define ICSP_OP_END           0x00
+#define ICSP_OP_INFO          0x01
+#define ICSP_OP_STATUS        0x02
+#define ICSP_OP_READ_VOLT     0x03
+#define ICSP_OP_SET_VDD       0x04
+#define ICSP_OP_VDD_MODE      0x05
+#define ICSP_OP_SET_VPP       0x06
+#define ICSP_OP_MCLR          0x07
+#define ICSP_OP_PINS          0x08
+#define ICSP_OP_DELAY_US      0x09
+#define ICSP_OP_DELAY_MS      0x0A
+#define ICSP_OP_SPEED         0x0B
+#define ICSP_OP_LED           0x0C
+#define ICSP_OP_CLEAR_FAULTS  0x0D
+#define ICSP_OP_WRITE_BITS    0x10
+#define ICSP_OP_READ_BITS     0x11
+#define ICSP_OP_KEY           0x12
+#define ICSP_OP_G6_CMD        0x20
+#define ICSP_OP_G6_LOAD       0x21
+#define ICSP_OP_G6_READ       0x22
+#define ICSP_OP_G6_READN      0x23
+#define ICSP_OP_G6_LOADN      0x24
+#define ICSP_OP_ICD_READY     0x40
+#define ICSP_OP_ICD_TX        0x41
+#define ICSP_OP_ICD_RX        0x42
+
+/* VDD_MODE arguments */
+#define ICSP_VDD_OFF          0
+#define ICSP_VDD_ON           1
+#define ICSP_VDD_DISCHARGE    2
+
+/* MCLR arguments */
+#define ICSP_MCLR_RELEASE     0
+#define ICSP_MCLR_GROUND      1
+#define ICSP_MCLR_VPP         2
+
+/* PINS byte */
+#define ICSP_PIN_DAT          0x01
+#define ICSP_PIN_DAT_IN       0x02
+#define ICSP_PIN_CLK          0x04
+#define ICSP_PIN_CLK_IN       0x08
+#define ICSP_PINS_IDLE        (ICSP_PIN_DAT_IN | ICSP_PIN_CLK_IN)
+#define ICSP_PINS_LOW         0x00
+
+/* STATUS power flags */
+#define ICSP_ST_VDD_ON        0x01
+#define ICSP_ST_VDD_GND       0x02
+#define ICSP_ST_VPP_PUMP      0x04
+#define ICSP_ST_VPP_SWITCH    0x08
+#define ICSP_ST_MCLR_GND      0x10
+#define ICSP_ST_VDD_FAULT     0x20
+#define ICSP_ST_VPP_FAULT     0x40
+#define ICSP_ST_BUTTON        0x80
+
+/* Probe status codes (first byte of a reply) */
+#define ICSP_ERR_TIMEOUT      5
+
+#define ICSP_VDD_MAX_MV       5000   /* the adapter refuses more */
+
+/** Settings the adapter driver keeps and the transport layer follows. */
+struct icsp_config {
+	unsigned int vdd_mv;       /**< target VDD setpoint */
+	unsigned int vpp_mv;       /**< VPP for high voltage entry */
+	bool power;                /**< the probe supplies the target */
+	bool hvp;                  /**< enter programming mode with VPP on MCLR */
+	bool power_off_on_quit;    /**< switch target power off when OpenOCD exits */
+};
+
+struct icsp_driver {
+	/**
+	 * Send one request packet (at most 64 bytes) and return the reply data.
+	 *
+	 * @param req request bytes
+	 * @param req_len number of request bytes
+	 * @param reply receives the reply data (everything after the two header
+	 *   bytes), at least 62 bytes
+	 * @param reply_len receives the number of data bytes
+	 * @param status receives the probe's status code (0 = ok)
+	 * @return ERROR_OK if the exchange worked and the status is 0
+	 */
+	int (*transact)(const uint8_t *req, size_t req_len,
+			uint8_t *reply, size_t *reply_len, uint8_t *status);
+
+	/** Settings, owned by the driver. */
+	struct icsp_config *config;
+};
+
+/* ---- Operation queue ---------------------------------------------------- */
+
+/**
+ * Queue one operation (opcode and arguments) that returns reply_len bytes.
+ * Nothing is sent before icsp_flush().
+ */
+int icsp_queue(const uint8_t *op, size_t len, size_t reply_len);
+
+/**
+ * Send everything queued, in as many packets as needed, and copy the
+ * returned data (all operations, in order) to out. out may be NULL if the
+ * caller does not care for the data; otherwise out_size must be big enough.
+ * The queue is emptied also on failure.
+ */
+int icsp_flush(uint8_t *out, size_t out_size);
+
+/** Discard the queue. */
+void icsp_queue_clear(void);
+
+/** Send one operation now. */
+int icsp_run(const uint8_t *op, size_t len, uint8_t *reply, size_t reply_len);
+
+/** Status code of the last failed exchange (0 if none). */
+uint8_t icsp_last_status(void);
+
+/* ---- Queued helpers (each only queues) ---------------------------------- */
+
+int icsp_set_vdd(unsigned int mv);
+int icsp_vdd_mode(unsigned int mode);
+int icsp_set_vpp(unsigned int mv);
+int icsp_mclr(unsigned int mode);
+int icsp_pins(uint8_t pins);
+int icsp_delay_us(unsigned int us);
+int icsp_delay_ms(unsigned int ms);
+int icsp_led(bool on);
+int icsp_clear_faults(void);
+
+/* ---- Immediate helpers --------------------------------------------------- */
+
+struct icsp_status {
+	uint8_t flags;      /**< ICSP_ST_* */
+	uint8_t pins;
+	unsigned int vdd_mv;
+	unsigned int vpp_mv;
+};
+
+int icsp_get_status(struct icsp_status *st);
+int icsp_wait_vpp(unsigned int mv, unsigned int timeout_ms);
+
+/** Release the pins and MCLR, VPP converter stopped. VDD untouched. */
+int icsp_release(void);
+
+/** Switch target power on at the configured setpoint (if not on yet). */
+int icsp_power_on(void);
+
+/** Discharge and switch target power off. */
+int icsp_power_off(void);
+
+/**
+ * Enter 6 bit command programming mode (PIC16F1xxx). Uses the high voltage
+ * method if configured, else the low voltage key sequence. With power the
+ * target is power cycled.
+ */
+int icsp_enter_programming(void);
+
+/**
+ * Leave programming mode; the target leaves reset. With keep_power the
+ * target supply stays on.
+ */
+int icsp_exit_programming(bool keep_power);
+
+/* ---- Debug executive link ------------------------------------------------ */
+
+/** The executive is waiting for a byte (target halted in debug mode). */
+int icsp_icd_ready(bool *ready);
+
+/** Send bytes, then optionally receive rx_len bytes (queued, flushed). */
+int icsp_icd_xfer(const uint8_t *tx, size_t tx_len, uint8_t *rx, size_t rx_len);
+
+/** Queue ICD_TX of tx (at most 60 bytes) and ICD_RX of rx_len bytes. */
+int icsp_icd_queue(const uint8_t *tx, size_t tx_len, size_t rx_len);
+
+/* ---- Settings ------------------------------------------------------------ */
+
+/** Settings of the selected adapter driver (never NULL once it is initialised). */
+const struct icsp_config *icsp_get_config(void);
+
+#endif /* OPENOCD_JTAG_ICSP_H */
