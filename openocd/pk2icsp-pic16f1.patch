diff --git a/src/target/pic16f1_icsp.c b/src/target/pic16f1_icsp.c
new file mode 100644
index 0000000..3cca4e9
--- /dev/null
+++ b/src/target/pic16f1_icsp.c
@@ -0,0 +1,426 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+/*
+ * ICSP programming primitives for PIC16F1 devices with 6 bit commands.
+ * See pic16f1_icsp.h. The algorithms follow Gen6 in host/pk2probe.py.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <jtag/icsp.h>
+#include <helper/log.h>
+#include <helper/binarybuffer.h>
+#include "image.h"
+#include "pic16f1_icsp.h"
+
+/* 6 bit commands */
+#define CMD_LOAD_CONFIG   0x00
+#define CMD_LOAD_PROG     0x02
+#define CMD_LOAD_DATA     0x03
+#define CMD_READ_PROG     0x04
+#define CMD_READ_DATA     0x05
+#define CMD_INCREMENT     0x06
+#define CMD_RESET_ADDR    0x16
+#define CMD_BEGIN_INT     0x08
+#define CMD_ERASE_PROG    0x09
+#define CMD_ERASE_DATA    0x0B
+#define CMD_ERASE_ROW     0x11
+
+#define T_PROG_MS    3
+#define T_CONFIG_MS  6
+#define T_ERASE_MS   6
+
+/* Device IDs and memory sizes are from the Microchip device family packs;
+ * write latch counts are from the programming specifications (same table
+ * as host/pk2probe.py). */
+#define F193X(name, id, lid, words) \
+	{ "PIC16F" name, id, 0x3FE0, words, 8, 256, 2, 5500, true }, \
+	{ "PIC16LF" name, lid, 0x3FE0, words, 8, 256, 2, 3600, true }
+
+static const struct pic16f1_device devices[] = {
+	F193X("1933", 0x2300, 0x2400, 4096),
+	F193X("1934", 0x2340, 0x2440, 4096),
+	F193X("1936", 0x2360, 0x2460, 8192),
+	F193X("1937", 0x2380, 0x2480, 8192),
+	F193X("1938", 0x23A0, 0x24A0, 16384),
+	F193X("1939", 0x23C0, 0x24C0, 16384),
+	/* Listed in the reference tool, not tried with this driver */
+	{ "PIC16F1829", 0x27E0, 0x3FE0, 8192, 32, 256, 2, 5500, false },
+	{ "PIC16F1619", 0x307D, 0x3FFF, 8192, 32, 0, 3, 5500, false },
+};
+
+const struct pic16f1_device *pic16f1_identify(uint16_t dev_word)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(devices); i++) {
+		if ((dev_word & devices[i].id_mask) == devices[i].dev_id)
+			return &devices[i];
+	}
+	return NULL;
+}
+
+void pic16f1_bytes_to_words(const uint8_t *bytes, unsigned int nwords, uint16_t *words)
+{
+	for (unsigned int i = 0; i < nwords; i++)
+		words[i] = (bytes[2 * i] | (bytes[2 * i + 1] << 8)) & PIC16F1_BLANK;
+}
+
+void pic16f1_words_to_bytes(const uint16_t *words, unsigned int nwords, uint8_t *bytes)
+{
+	for (unsigned int i = 0; i < nwords; i++) {
+		bytes[2 * i] = words[i] & 0xFF;
+		bytes[2 * i + 1] = words[i] >> 8;
+	}
+}
+
+static int g6_cmd(uint8_t cmd)
+{
+	const uint8_t op[] = { ICSP_OP_G6_CMD, cmd };
+	return icsp_queue(op, sizeof(op), 0);
+}
+
+static int g6_load(uint8_t cmd, uint16_t word)
+{
+	const uint8_t op[] = { ICSP_OP_G6_LOAD, cmd, word & 0xFF, word >> 8 };
+	return icsp_queue(op, sizeof(op), 0);
+}
+
+/* Leave the address counter at addr. It can only be reset to 0, loaded
+ * with 0x8000, or incremented. */
+static int seek(uint32_t addr)
+{
+	uint32_t n;
+
+	if (addr >= 0x8000) {
+		g6_load(CMD_LOAD_CONFIG, 0x3FFF);
+		n = addr - 0x8000;
+	} else {
+		g6_cmd(CMD_RESET_ADDR);
+		n = addr;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		int retval = g6_cmd(CMD_INCREMENT);
+		if (retval != ERROR_OK)
+			return retval;
+		/* keep the queue bounded */
+		if ((i & 0x3FFF) == 0x3FFF && icsp_flush(NULL, 0) != ERROR_OK)
+			return ERROR_FAIL;
+	}
+	return ERROR_OK;
+}
+
+int pic16f1_read_words(uint32_t addr, unsigned int count, uint16_t *words)
+{
+	uint8_t *buf = malloc(2 * count + 2);
+	if (!buf)
+		return ERROR_FAIL;
+
+	int retval = icsp_flush(NULL, 0);
+	if (retval == ERROR_OK)
+		retval = seek(addr);
+	if (retval == ERROR_OK)
+		retval = icsp_flush(NULL, 0);
+
+	unsigned int done = 0;
+	while (retval == ERROR_OK && done < count) {
+		/* a packet carries at most 62 bytes of reply: 31 words */
+		unsigned int n = MIN(count - done, 31U);
+		const uint8_t op[] = { ICSP_OP_G6_READN, CMD_READ_PROG, CMD_INCREMENT, n };
+		retval = icsp_queue(op, sizeof(op), 2 * n);
+		if (retval == ERROR_OK)
+			retval = icsp_flush(buf + 2 * done, 2 * (count - done));
+		done += n;
+	}
+	if (retval == ERROR_OK) {
+		for (unsigned int i = 0; i < count; i++)
+			words[i] = buf[2 * i] | (buf[2 * i + 1] << 8);
+	}
+	free(buf);
+	return retval;
+}
+
+int pic16f1_read_eeprom(unsigned int count, uint8_t *bytes)
+{
+	uint8_t *buf = malloc(2 * count + 2);
+	if (!buf)
+		return ERROR_FAIL;
+
+	int retval = icsp_flush(NULL, 0);
+	if (retval == ERROR_OK)
+		retval = g6_cmd(CMD_RESET_ADDR);
+	if (retval == ERROR_OK)
+		retval = icsp_flush(NULL, 0);
+	unsigned int done = 0;
+	while (retval == ERROR_OK && done < count) {
+		unsigned int n = MIN(count - done, 31U);
+		const uint8_t op[] = { ICSP_OP_G6_READN, CMD_READ_DATA, CMD_INCREMENT, n };
+		retval = icsp_queue(op, sizeof(op), 2 * n);
+		if (retval == ERROR_OK)
+			retval = icsp_flush(buf + 2 * done, 2 * (count - done));
+		done += n;
+	}
+	if (retval == ERROR_OK) {
+		for (unsigned int i = 0; i < count; i++)
+			bytes[i] = buf[2 * i];
+	}
+	free(buf);
+	return retval;
+}
+
+int pic16f1_connect(const struct pic16f1_device **dev, uint16_t *rev, uint16_t *dev_word)
+{
+	const struct icsp_config *c = icsp_get_config();
+	uint16_t ids[2];
+
+	int retval = icsp_enter_programming();
+	if (retval != ERROR_OK)
+		return retval;
+
+	retval = pic16f1_read_words(PIC16F1_REVID_ADDR, 2, ids);
+	if (retval != ERROR_OK) {
+		icsp_exit_programming(true);
+		return retval;
+	}
+
+	const struct pic16f1_device *d = pic16f1_identify(ids[1]);
+	if (!d) {
+		LOG_ERROR("pic16f1: no supported device answered (device ID word 0x%04x); "
+			"check wiring, power and the entry method (pk2icsp hvp on)", ids[1]);
+		icsp_exit_programming(true);
+		return ERROR_FAIL;
+	}
+	if (c->power && c->vdd_mv > d->vdd_max_mv) {
+		LOG_ERROR("pic16f1: %s allows at most %.1f V, VDD is set to %.1f V",
+			d->name, d->vdd_max_mv / 1000.0, c->vdd_mv / 1000.0);
+		icsp_exit_programming(false);
+		return ERROR_FAIL;
+	}
+	if (dev)
+		*dev = d;
+	if (rev)
+		*rev = ids[0];
+	if (dev_word)
+		*dev_word = ids[1];
+	return ERROR_OK;
+}
+
+int pic16f1_disconnect(void)
+{
+	return icsp_exit_programming(true);
+}
+
+int pic16f1_bulk_erase(const struct pic16f1_device *dev)
+{
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	/* With the address in configuration space the user IDs and the
+	 * configuration words go too. */
+	g6_load(CMD_LOAD_CONFIG, 0x3FFF);
+	g6_cmd(CMD_ERASE_PROG);
+	icsp_delay_ms(T_ERASE_MS);
+	if (dev && dev->eeprom) {
+		g6_cmd(CMD_ERASE_DATA);
+		icsp_delay_ms(T_ERASE_MS);
+	}
+	g6_cmd(CMD_RESET_ADDR);
+	return icsp_flush(NULL, 0);
+}
+
+int pic16f1_erase_eeprom(void)
+{
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	g6_load(CMD_LOAD_CONFIG, 0x3FFF);
+	g6_cmd(CMD_ERASE_DATA);
+	icsp_delay_ms(T_ERASE_MS);
+	g6_cmd(CMD_RESET_ADDR);
+	return icsp_flush(NULL, 0);
+}
+
+int pic16f1_row_erase(uint32_t addr)
+{
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	seek(addr);
+	g6_cmd(CMD_ERASE_ROW);
+	icsp_delay_ms(T_ERASE_MS);
+	return icsp_flush(NULL, 0);
+}
+
+int pic16f1_write_flash(const struct pic16f1_device *dev, uint32_t first,
+		const uint16_t *words, unsigned int count)
+{
+	unsigned int row = dev->latches;
+
+	if (first % row || count % row)
+		return ERROR_FAIL;
+
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	seek(first);
+	for (unsigned int base = 0; base < count; base += row) {
+		bool blank = true;
+		for (unsigned int i = 0; i < row; i++)
+			if (words[base + i] != PIC16F1_BLANK)
+				blank = false;
+		if (blank) {
+			for (unsigned int i = 0; i < row; i++)
+				g6_cmd(CMD_INCREMENT);
+		} else {
+			for (unsigned int i = 0; i < row; i += 29) {
+				unsigned int n = MIN(row - i, 29U);
+				uint8_t op[4 + 2 * 29];
+				op[0] = ICSP_OP_G6_LOADN;
+				op[1] = CMD_LOAD_PROG;
+				op[2] = CMD_INCREMENT;
+				op[3] = n;
+				for (unsigned int k = 0; k < n; k++) {
+					op[4 + 2 * k] = words[base + i + k] & 0xFF;
+					op[5 + 2 * k] = words[base + i + k] >> 8;
+				}
+				icsp_queue(op, 4 + 2 * n, 0);
+				if (i + 29 < row)
+					g6_cmd(CMD_INCREMENT);
+			}
+			g6_cmd(CMD_BEGIN_INT);
+			icsp_delay_ms(T_PROG_MS);
+			g6_cmd(CMD_INCREMENT);
+		}
+	}
+	return icsp_flush(NULL, 0);
+}
+
+int pic16f1_write_config_words(uint32_t addr, const uint16_t *words, unsigned int count)
+{
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	g6_load(CMD_LOAD_CONFIG, 0x3FFF);
+	uint32_t cur = 0x8000;
+	for (unsigned int i = 0; i < count; i++) {
+		while (cur < addr + i) {
+			g6_cmd(CMD_INCREMENT);
+			cur++;
+		}
+		g6_load(CMD_LOAD_PROG, words[i]);
+		g6_cmd(CMD_BEGIN_INT);
+		icsp_delay_ms(T_CONFIG_MS);
+	}
+	return icsp_flush(NULL, 0);
+}
+
+int pic16f1_write_eeprom(unsigned int first, const uint8_t *bytes, unsigned int count)
+{
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	g6_cmd(CMD_RESET_ADDR);
+	for (unsigned int i = 0; i < first; i++)
+		g6_cmd(CMD_INCREMENT);
+	for (unsigned int i = 0; i < count; i++) {
+		if (bytes[i] != 0xFF) {
+			g6_load(CMD_LOAD_DATA, bytes[i]);
+			g6_cmd(CMD_BEGIN_INT);
+			icsp_delay_ms(T_CONFIG_MS);
+		}
+		g6_cmd(CMD_INCREMENT);
+	}
+	return icsp_flush(NULL, 0);
+}
+
+/* ---- HEX images ------------------------------------------------------------ */
+
+void pic16f1_image_free(struct pic16f1_image *img)
+{
+	free(img->flash);
+	img->flash = NULL;
+}
+
+int pic16f1_image_split(struct image *image, const struct pic16f1_device *dev,
+		struct pic16f1_image *out)
+{
+	size_t flash_bytes = (size_t)dev->flash_words * 2;
+	uint8_t *fb = malloc(flash_bytes);
+	uint8_t cb[2 * PIC16F1_CONFIG_SPACE_WORDS];
+	uint8_t eb[2 * PIC16F1_MAX_EEPROM];
+	bool cp[2 * PIC16F1_CONFIG_SPACE_WORDS] = { false };
+	bool ep[2 * PIC16F1_MAX_EEPROM] = { false };
+	bool *fp = calloc(flash_bytes, 1);
+	int retval = ERROR_OK;
+
+	memset(out, 0, sizeof(*out));
+	memset(cb, 0xFF, sizeof(cb));
+	memset(eb, 0xFF, sizeof(eb));
+	out->flash = malloc(dev->flash_words * sizeof(uint16_t));
+	if (!fb || !fp || !out->flash) {
+		retval = ERROR_FAIL;
+		goto done;
+	}
+	memset(fb, 0xFF, flash_bytes);
+
+	for (unsigned int s = 0; s < image->num_sections; s++) {
+		uint32_t base = image->sections[s].base_address;
+		uint32_t size = image->sections[s].size;
+		uint8_t *data = malloc(size ? size : 1);
+		size_t got = 0;
+
+		if (!data) {
+			retval = ERROR_FAIL;
+			goto done;
+		}
+		if (image_read_section(image, s, 0, size, data, &got) != ERROR_OK || got != size) {
+			free(data);
+			retval = ERROR_FAIL;
+			goto done;
+		}
+		for (uint32_t i = 0; i < size; i++) {
+			uint32_t a = base + i;
+			if (a < flash_bytes) {
+				fb[a] = data[i];
+				fp[a] = true;
+			} else if (a < PIC16F1_BASE_CONFIG) {
+				LOG_ERROR("pic16f1: HEX data at byte address 0x%05" PRIx32
+					" is beyond the %" PRIu32 " word flash", a, dev->flash_words);
+				free(data);
+				retval = ERROR_FAIL;
+				goto done;
+			} else if (a < PIC16F1_BASE_CONFIG + sizeof(cb)) {
+				cb[a - PIC16F1_BASE_CONFIG] = data[i];
+				cp[a - PIC16F1_BASE_CONFIG] = true;
+			} else if (a >= PIC16F1_BASE_EEPROM && a < PIC16F1_BASE_EEPROM + 2 * dev->eeprom) {
+				ep[a - PIC16F1_BASE_EEPROM] = true;
+				eb[a - PIC16F1_BASE_EEPROM] = data[i];
+			} else {
+				LOG_DEBUG("pic16f1: ignoring HEX data at byte address 0x%05" PRIx32, a);
+			}
+		}
+		free(data);
+	}
+
+	pic16f1_bytes_to_words(fb, dev->flash_words, out->flash);
+	/* a word with only its low byte present has the high byte blank */
+	pic16f1_bytes_to_words(cb, PIC16F1_CONFIG_SPACE_WORDS, out->cfg);
+	for (unsigned int i = 0; i < PIC16F1_CONFIG_SPACE_WORDS; i++) {
+		out->cfg_present[i] = cp[2 * i] || cp[2 * i + 1];
+		/* Only words the part implements as user IDs or configuration
+		 * words are ever written (see flash driver). */
+	}
+	for (unsigned int i = 0; i < dev->eeprom; i++) {
+		if (ep[2 * i]) {
+			out->ee[i] = eb[2 * i];
+			out->has_ee = true;
+		}
+	}
+	retval = ERROR_OK;
+done:
+	free(fb);
+	free(fp);
+	if (retval != ERROR_OK)
+		pic16f1_image_free(out);
+	return retval;
+}
diff --git a/src/target/pic16f1_icsp.h b/src/target/pic16f1_icsp.h
new file mode 100644
index 0000000..24d6a79
--- /dev/null
+++ b/src/target/pic16f1_icsp.h
@@ -0,0 +1,118 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/*
+ * ICSP programming primitives for PIC16F1 devices with 6 bit commands
+ * (PIC16F1xxx, e.g. PIC16(L)F193x), shared by the pic16f1 flash driver and
+ * the pic16f1 target (debug load).  They run on top of the icsp transport
+ * (jtag/icsp.h) and are modelled on Gen6 in host/pk2probe.py of the probe
+ * project.
+ *
+ * Addresses are word addresses in the device's program space: 0 to
+ * flash_words - 1 is user program memory, 0x8000 and up is configuration
+ * space (0x8000-0x8003 user IDs, 0x8004 debug vector, 0x8005 revision,
+ * 0x8006 device ID, 0x8007-0x8008 configuration words, 0x8009-0x800A
+ * calibration, 0x8010-0x80FF debug executive when DEBUG is enabled).
+ */
+
+#ifndef OPENOCD_TARGET_PIC16F1_ICSP_H
+#define OPENOCD_TARGET_PIC16F1_ICSP_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+struct image;
+
+#define PIC16F1_BLANK          0x3FFF
+#define PIC16F1_USERID_ADDR    0x8000
+#define PIC16F1_USERID_WORDS   4
+#define PIC16F1_REVID_ADDR     0x8005
+#define PIC16F1_DEVID_ADDR     0x8006
+#define PIC16F1_CONFIG_ADDR    0x8007
+#define PIC16F1_CONFIG_SPACE_WORDS 16   /* 0x8000-0x800F is what the flash bank covers */
+#define PIC16F1_EEPROM_HEX     0xF000   /* HEX word address of data EEPROM */
+#define PIC16F1_MAX_EEPROM     256
+
+/* Image (HEX file) byte address of the three regions (word address * 2) */
+#define PIC16F1_BASE_FLASH     0x00000
+#define PIC16F1_BASE_CONFIG    0x10000
+#define PIC16F1_BASE_EEPROM    0x1E000
+
+/* PIC16(L)F193x: DEBUG is bit 12 of configuration word 2; 0 = enabled */
+#define PIC16F1_CONFIG2_ADDR   0x8008
+#define PIC16F1_CONFIG2_DEBUG  0x1000
+
+struct pic16f1_device {
+	const char *name;
+	uint16_t dev_id;           /* device ID, with the revision bits masked out */
+	uint16_t id_mask;
+	uint32_t flash_words;
+	unsigned int latches;      /* words per program memory write */
+	unsigned int eeprom;       /* bytes of data EEPROM */
+	unsigned int config_words; /* number of configuration words from 0x8007 */
+	unsigned int vdd_max_mv;
+	bool debug;                /* has the on-chip debug executive support */
+};
+
+const struct pic16f1_device *pic16f1_identify(uint16_t dev_word);
+
+/**
+ * Enter programming mode (as configured for the adapter), read the device
+ * ID and identify the device. Stays in programming mode on success.
+ * @param expect if not NULL, the device found must be this one.
+ */
+int pic16f1_connect(const struct pic16f1_device **dev, uint16_t *rev, uint16_t *dev_word);
+
+/** Leave programming mode; the target leaves reset and keeps its power. */
+int pic16f1_disconnect(void);
+
+int pic16f1_read_words(uint32_t addr, unsigned int count, uint16_t *words);
+int pic16f1_read_eeprom(unsigned int count, uint8_t *bytes);
+
+/** Bulk erase: program memory, user IDs, configuration words, EEPROM. */
+int pic16f1_bulk_erase(const struct pic16f1_device *dev);
+
+/** Erase the data EEPROM only. */
+int pic16f1_erase_eeprom(void);
+
+/** Row erase (32 words) of the row containing addr, in debug space. */
+int pic16f1_row_erase(uint32_t addr);
+
+/**
+ * Write program memory words starting at word address first (a multiple of
+ * the write latch size; count too). Blank latches are skipped.
+ */
+int pic16f1_write_flash(const struct pic16f1_device *dev, uint32_t first,
+		const uint16_t *words, unsigned int count);
+
+/** Write single words in configuration space, one at a time. */
+int pic16f1_write_config_words(uint32_t addr, const uint16_t *words, unsigned int count);
+
+/** Write data EEPROM bytes from address first (0xFF bytes are skipped). */
+int pic16f1_write_eeprom(unsigned int first, const uint8_t *bytes, unsigned int count);
+
+/** An HEX image split into the device's regions. */
+struct pic16f1_image {
+	uint16_t *flash;               /* flash_words entries, BLANK where absent */
+	uint16_t cfg[PIC16F1_CONFIG_SPACE_WORDS];   /* words 0x8000-0x800F */
+	bool cfg_present[PIC16F1_CONFIG_SPACE_WORDS];
+	uint8_t ee[PIC16F1_MAX_EEPROM];
+	bool has_ee;
+};
+
+int pic16f1_image_split(struct image *image, const struct pic16f1_device *dev,
+		struct pic16f1_image *out);
+void pic16f1_image_free(struct pic16f1_image *img);
+
+/** Convert HEX bytes (little endian words) to 14 bit words. */
+void pic16f1_bytes_to_words(const uint8_t *bytes, unsigned int nwords, uint16_t *words);
+void pic16f1_words_to_bytes(const uint16_t *words, unsigned int nwords, uint8_t *bytes);
+
+struct target;
+
+/**
+ * Programming mode resets the target: forget its state (debug session,
+ * register cache) so that the next poll finds out. No-op for other targets.
+ */
+void pic16f1_target_link_lost(struct target *target);
+
+#endif /* OPENOCD_TARGET_PIC16F1_ICSP_H */
