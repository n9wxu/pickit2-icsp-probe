index 0000000..04bf8ae
--- /dev/null
+++ b/src/flash/nor/pic16f1.c
@@ -0,0 +1,567 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+/*
+ * Flash driver for Microchip PIC16F1 devices with 6 bit ICSP commands
+ * (PIC16(L)F193x), through the icsp transport.
+ *
+ * A device is described by three banks, selected by their base address,
+ * which is the byte address in an Intel HEX file (word address * 2):
+ *
+ *   base 0x00000  program flash        (size is set by the probe, 2 * words)
+ *   base 0x10000  user IDs and configuration words (word space 0x8000-0x800F)
+ *   base 0x1E000  data EEPROM          (HEX word address 0xF000+; one byte per
+ *                                       word, in the low byte)
+ *
+ *   flash bank f.flash  pic16f1 0x00000 0 0 0 $_TARGETNAME
+ *   flash bank f.config pic16f1 0x10000 0 0 0 $_TARGETNAME
+ *   flash bank f.eeprom pic16f1 0x1E000 0 0 0 $_TARGETNAME
+ *
+ * Erasing: the device is bulk erased, there is no sector erase. The program
+ * flash bank has a single sector, and erasing it (erase_sector, erase_address,
+ * write_image erase) bulk erases program memory, the user IDs, the
+ * configuration words and the data EEPROM. The calibration words are not
+ * touched. Erasing the EEPROM bank erases the data EEPROM only. The
+ * configuration bank cannot be erased on its own: erasing it does nothing
+ * (it is erased by the program flash bank, which comes first in an image).
+ *
+ * Every operation enters programming mode, which resets the target, and
+ * leaves the target running with its power on. A debug session is lost.
+ *
+ * Programming the configuration words: an image that would enable DEBUG is
+ * refused (use "pic16f1 load_debug"), because a part with DEBUG enabled and
+ * no debug executive does not run.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "imp.h"
+#include <helper/binarybuffer.h>
+#include <target/target.h>
+#include <target/pic16f1_icsp.h>
+
+enum pic16f1_role {
+	ROLE_FLASH,
+	ROLE_CONFIG,
+	ROLE_EEPROM,
+};
+
+struct pic16f1_bank {
+	enum pic16f1_role role;
+	bool probed;
+};
+
+/* One device, shared by the banks, so that only one probe is needed */
+static const struct pic16f1_device *probed_device;
+static uint16_t probed_rev;
+
+static int session_begin(struct flash_bank *bank, const struct pic16f1_device **dev)
+{
+	int retval = pic16f1_connect(dev, NULL, NULL);
+	if (retval != ERROR_OK)
+		return retval;
+	if (probed_device && *dev != probed_device) {
+		LOG_ERROR("pic16f1: the device is %s, but %s was probed; run 'flash probe'",
+			(*dev)->name, probed_device->name);
+		pic16f1_disconnect();
+		return ERROR_FAIL;
+	}
+	return ERROR_OK;
+}
+
+static int session_end(struct flash_bank *bank)
+{
+	int retval = pic16f1_disconnect();
+	pic16f1_target_link_lost(bank->target);
+	return retval;
+}
+
+FLASH_BANK_COMMAND_HANDLER(pic16f1_flash_bank_command)
+{
+	struct pic16f1_bank *b;
+
+	if (CMD_ARGC < 6)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	b = calloc(1, sizeof(*b));
+	if (!b)
+		return ERROR_FAIL;
+	switch (bank->base) {
+	case PIC16F1_BASE_FLASH:
+		b->role = ROLE_FLASH;
+		break;
+	case PIC16F1_BASE_CONFIG:
+		b->role = ROLE_CONFIG;
+		break;
+	case PIC16F1_BASE_EEPROM:
+		b->role = ROLE_EEPROM;
+		break;
+	default:
+		LOG_ERROR("pic16f1: bank base must be 0x0 (flash), 0x10000 (user IDs and "
+			"configuration) or 0x1E000 (EEPROM)");
+		free(b);
+		return ERROR_FAIL;
+	}
+	bank->driver_priv = b;
+	return ERROR_OK;
+}
+
+static void set_geometry(struct flash_bank *bank, const struct pic16f1_device *dev)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+	uint32_t size = 0;
+
+	switch (b->role) {
+	case ROLE_FLASH:
+		size = dev->flash_words * 2;
+		bank->write_start_alignment = bank->write_end_alignment = dev->latches * 2;
+		break;
+	case ROLE_CONFIG:
+		size = PIC16F1_CONFIG_SPACE_WORDS * 2;
+		bank->write_start_alignment = bank->write_end_alignment = 2;
+		break;
+	case ROLE_EEPROM:
+		size = dev->eeprom * 2;
+		bank->write_start_alignment = bank->write_end_alignment = 2;
+		break;
+	}
+	free(bank->sectors);
+	bank->sectors = NULL;
+	bank->num_sectors = 0;
+	bank->size = size;
+	if (size) {
+		bank->sectors = alloc_block_array(0, size, 1);
+		if (!bank->sectors)
+			return;
+		bank->num_sectors = 1;
+	}
+	bank->bus_width = 2;
+	bank->chip_width = 2;
+}
+
+static int pic16f1_probe(struct flash_bank *bank)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+	const struct pic16f1_device *dev;
+	uint16_t rev, devw;
+
+	b->probed = false;
+	int retval = pic16f1_connect(&dev, &rev, &devw);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = session_end(bank);
+	if (retval != ERROR_OK)
+		return retval;
+
+	probed_device = dev;
+	probed_rev = devw & ~dev->id_mask & 0x3FFF;
+	LOG_INFO("pic16f1: %s, device ID 0x%04x, revision %u, %" PRIu32 " words of flash, %u bytes of EEPROM",
+		dev->name, devw & dev->id_mask, devw & ~dev->id_mask & 0x3FFF,
+		dev->flash_words, dev->eeprom);
+	set_geometry(bank, dev);
+	b->probed = true;
+	return ERROR_OK;
+}
+
+static int pic16f1_auto_probe(struct flash_bank *bank)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+
+	if (b->probed)
+		return ERROR_OK;
+	if (probed_device) {
+		set_geometry(bank, probed_device);
+		b->probed = true;
+		return ERROR_OK;
+	}
+	return pic16f1_probe(bank);
+}
+
+/* ---- Reading --------------------------------------------------------------------- */
+
+/* Read the words covering the byte range, return them as little endian bytes. */
+static int read_range(struct flash_bank *bank, const struct pic16f1_device *dev,
+		uint8_t *buffer, uint32_t offset, uint32_t count)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+	uint32_t first = offset / 2;
+	uint32_t last = (offset + count + 1) / 2;   /* exclusive */
+	uint32_t nwords = last - first;
+	uint16_t *words = calloc(nwords ? nwords : 1, sizeof(uint16_t));
+	uint8_t *bytes = malloc(2 * nwords + 1);
+	int retval = ERROR_OK;
+
+	if (!words || !bytes) {
+		free(words);
+		free(bytes);
+		return ERROR_FAIL;
+	}
+	switch (b->role) {
+	case ROLE_FLASH:
+		retval = pic16f1_read_words(first, nwords, words);
+		break;
+	case ROLE_CONFIG:
+		retval = pic16f1_read_words(0x8000 + first, nwords, words);
+		break;
+	case ROLE_EEPROM: {
+		uint8_t ee[PIC16F1_MAX_EEPROM];
+		retval = pic16f1_read_eeprom(dev->eeprom, ee);
+		for (uint32_t i = 0; retval == ERROR_OK && i < nwords; i++)
+			words[i] = ee[first + i];
+		break;
+	}
+	}
+	if (retval == ERROR_OK) {
+		pic16f1_words_to_bytes(words, nwords, bytes);
+		memcpy(buffer, bytes + (offset & 1), count);
+	}
+	free(words);
+	free(bytes);
+	return retval;
+}
+
+static int pic16f1_read(struct flash_bank *bank, uint8_t *buffer, uint32_t offset, uint32_t count)
+{
+	const struct pic16f1_device *dev;
+
+	int retval = pic16f1_auto_probe(bank);
+	if (retval != ERROR_OK)
+		return retval;
+	if (offset + count > bank->size) {
+		LOG_ERROR("pic16f1: read beyond the end of the bank");
+		return ERROR_FAIL;
+	}
+	retval = session_begin(bank, &dev);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = read_range(bank, dev, buffer, offset, count);
+	int r2 = session_end(bank);
+	return retval != ERROR_OK ? retval : r2;
+}
+
+static int pic16f1_verify(struct flash_bank *bank, const uint8_t *buffer,
+		uint32_t offset, uint32_t count)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+	uint8_t *back = malloc(count ? count : 1);
+	unsigned int diffs = 0;
+
+	if (!back)
+		return ERROR_FAIL;
+	int retval = pic16f1_read(bank, back, offset, count);
+	if (retval == ERROR_OK) {
+		for (uint32_t i = 0; i < count; i++) {
+			uint32_t a = offset + i;
+			uint8_t want = buffer[i], got = back[i];
+
+			if (b->role == ROLE_FLASH && (a & 1))
+				want &= 0x3F, got &= 0x3F;
+			/* the EEPROM keeps one byte per word, in the low byte */
+			if (b->role == ROLE_EEPROM && (a & 1))
+				continue;
+			if (b->role == ROLE_CONFIG) {
+				uint32_t w = a / 2;
+				bool wanted = w < 4 || (w >= 7 && probed_device &&
+					w < 7U + probed_device->config_words);
+				if (!wanted)
+					continue;
+				if (a & 1)
+					want &= 0x3F, got &= 0x3F;
+			}
+			if (want != got) {
+				if (diffs++ < 5)
+					LOG_ERROR("pic16f1: verify mismatch at byte 0x%05" PRIx32 ": expected 0x%02x, read 0x%02x",
+						(uint32_t)bank->base + a, want, got);
+			}
+		}
+		if (diffs) {
+			LOG_ERROR("pic16f1: %u byte(s) differ", diffs);
+			retval = ERROR_FAIL;
+		}
+	}
+	free(back);
+	return retval;
+}
+
+static int pic16f1_erase_check(struct flash_bank *bank)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+	const struct pic16f1_device *dev;
+
+	int retval = pic16f1_auto_probe(bank);
+	if (retval != ERROR_OK)
+		return retval;
+	if (!bank->num_sectors)
+		return ERROR_OK;
+
+	uint8_t *buf = malloc(bank->size);
+	if (!buf)
+		return ERROR_FAIL;
+	retval = session_begin(bank, &dev);
+	if (retval == ERROR_OK) {
+		retval = read_range(bank, dev, buf, 0, bank->size);
+		session_end(bank);
+	}
+	if (retval == ERROR_OK) {
+		bool blank = true;
+		for (uint32_t i = 0; i < bank->size; i++) {
+			uint32_t w = i / 2;
+			uint8_t v = buf[i];
+
+			if (b->role == ROLE_CONFIG && !(w < 4 || (w >= 7 && w < 7U + dev->config_words)))
+				continue;
+			if (b->role == ROLE_EEPROM && (i & 1))
+				continue;
+			if (b->role != ROLE_EEPROM && (i & 1))
+				v |= 0xC0;
+			if (v != 0xFF)
+				blank = false;
+		}
+		bank->sectors[0].is_erased = blank ? 1 : 0;
+	}
+	free(buf);
+	return retval;
+}
+
+/* ---- Erasing ----------------------------------------------------------------------- */
+
+static int pic16f1_erase(struct flash_bank *bank, unsigned int first, unsigned int last)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+	const struct pic16f1_device *dev;
+
+	int retval = pic16f1_auto_probe(bank);
+	if (retval != ERROR_OK)
+		return retval;
+	if (!bank->num_sectors || first != 0 || last != 0)
+		return ERROR_FLASH_SECTOR_INVALID;
+
+	switch (b->role) {
+	case ROLE_CONFIG:
+		LOG_INFO("pic16f1: user IDs and configuration words are erased by erasing the "
+			"program flash bank (bulk erase); nothing done for this bank");
+		return ERROR_OK;
+	case ROLE_FLASH:
+		LOG_INFO("pic16f1: bulk erase: program memory, user IDs, configuration words and EEPROM");
+		break;
+	case ROLE_EEPROM:
+		break;
+	}
+
+	retval = session_begin(bank, &dev);
+	if (retval != ERROR_OK)
+		return retval;
+	if (b->role == ROLE_FLASH) {
+		retval = pic16f1_bulk_erase(dev);
+	} else {
+		retval = pic16f1_erase_eeprom();
+	}
+	int r2 = session_end(bank);
+	if (retval == ERROR_OK)
+		retval = r2;
+	if (retval == ERROR_OK)
+		bank->sectors[0].is_erased = 1;
+	return retval;
+}
+
+/* ---- Writing ----------------------------------------------------------------------- */
+
+static int write_flash(struct flash_bank *bank, const struct pic16f1_device *dev,
+		const uint8_t *buffer, uint32_t offset, uint32_t count)
+{
+	uint32_t row = dev->latches * 2;
+	uint32_t nwords = count / 2;
+	uint16_t *words;
+
+	if (offset % row || count % row) {
+		LOG_ERROR("pic16f1: flash writes must be aligned to %u bytes", (unsigned int)row);
+		return ERROR_FLASH_DST_BREAKS_ALIGNMENT;
+	}
+	words = malloc(nwords * sizeof(uint16_t));
+	if (!words)
+		return ERROR_FAIL;
+	pic16f1_bytes_to_words(buffer, nwords, words);
+	int retval = pic16f1_write_flash(dev, offset / 2, words, nwords);
+	if (retval == ERROR_OK) {
+		uint16_t *back = malloc(nwords * sizeof(uint16_t));
+		unsigned int errors = 0;
+
+		if (!back) {
+			free(words);
+			return ERROR_FAIL;
+		}
+		retval = pic16f1_read_words(offset / 2, nwords, back);
+		for (uint32_t i = 0; retval == ERROR_OK && i < nwords; i++) {
+			if (back[i] != words[i]) {
+				if (errors++ < 5)
+					LOG_ERROR("pic16f1: flash word 0x%04" PRIx32 ": wrote 0x%04x, read 0x%04x",
+						offset / 2 + i, words[i], back[i]);
+			}
+		}
+		if (errors) {
+			LOG_ERROR("pic16f1: verify failed, %u word(s) differ; was the flash erased?", errors);
+			retval = ERROR_FAIL;
+		}
+		free(back);
+	}
+	free(words);
+	return retval;
+}
+
+static int write_config(struct flash_bank *bank, const struct pic16f1_device *dev,
+		const uint8_t *buffer, uint32_t offset, uint32_t count)
+{
+	uint32_t first = offset / 2;
+	uint32_t nwords = count / 2;
+	uint16_t *words = malloc(nwords * sizeof(uint16_t));
+	int retval = ERROR_OK;
+
+	if (!words)
+		return ERROR_FAIL;
+	if ((offset | count) & 1) {
+		LOG_ERROR("pic16f1: configuration writes must be whole words");
+		free(words);
+		return ERROR_FLASH_DST_BREAKS_ALIGNMENT;
+	}
+	pic16f1_bytes_to_words(buffer, nwords, words);
+
+	for (uint32_t i = 0; i < nwords; i++) {
+		uint32_t w = first + i;
+		if (w == PIC16F1_CONFIG2_ADDR - 0x8000 && dev->debug &&
+				!(words[i] & PIC16F1_CONFIG2_DEBUG) && words[i] != PIC16F1_BLANK) {
+			LOG_ERROR("pic16f1: configuration word 2 enables DEBUG; a part with DEBUG "
+				"enabled needs the debug executive, use 'pic16f1 load_debug' instead");
+			free(words);
+			return ERROR_FAIL;
+		}
+	}
+	for (uint32_t i = 0; i < nwords && retval == ERROR_OK; i++) {
+		uint32_t w = first + i;
+		bool writable = w < PIC16F1_USERID_WORDS ||
+			(w >= PIC16F1_CONFIG_ADDR - 0x8000 &&
+			 w < PIC16F1_CONFIG_ADDR - 0x8000 + dev->config_words);
+
+		if (words[i] == PIC16F1_BLANK)
+			continue;
+		if (!writable) {
+			LOG_WARNING("pic16f1: not writing word 0x%04x (not a user ID or configuration word)",
+				0x8000 + w);
+			continue;
+		}
+		retval = pic16f1_write_config_words(0x8000 + w, &words[i], 1);
+		if (retval == ERROR_OK) {
+			uint16_t back;
+			retval = pic16f1_read_words(0x8000 + w, 1, &back);
+			if (retval == ERROR_OK && back != words[i]) {
+				LOG_ERROR("pic16f1: word 0x%04x: wrote 0x%04x, read 0x%04x",
+					0x8000 + w, words[i], back);
+				retval = ERROR_FAIL;
+			}
+		}
+	}
+	free(words);
+	return retval;
+}
+
+static int write_eeprom(struct flash_bank *bank, const struct pic16f1_device *dev,
+		const uint8_t *buffer, uint32_t offset, uint32_t count)
+{
+	uint32_t first = offset / 2;
+	uint32_t n = count / 2;
+	uint8_t *bytes = malloc(n ? n : 1);
+	uint8_t *back = malloc(PIC16F1_MAX_EEPROM);
+	int retval = ERROR_OK;
+
+	if (!bytes || !back) {
+		free(bytes);
+		free(back);
+		return ERROR_FAIL;
+	}
+	for (uint32_t i = 0; i < n; i++)
+		bytes[i] = buffer[2 * i];
+	retval = pic16f1_write_eeprom(first, bytes, n);
+	if (retval == ERROR_OK)
+		retval = pic16f1_read_eeprom(dev->eeprom, back);
+	for (uint32_t i = 0; retval == ERROR_OK && i < n; i++) {
+		if (bytes[i] != 0xFF && back[first + i] != bytes[i]) {
+			LOG_ERROR("pic16f1: EEPROM 0x%02" PRIx32 ": wrote 0x%02x, read 0x%02x",
+				first + i, bytes[i], back[first + i]);
+			retval = ERROR_FAIL;
+		}
+	}
+	free(bytes);
+	free(back);
+	return retval;
+}
+
+static int pic16f1_write(struct flash_bank *bank, const uint8_t *buffer,
+		uint32_t offset, uint32_t count)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+	const struct pic16f1_device *dev;
+
+	int retval = pic16f1_auto_probe(bank);
+	if (retval != ERROR_OK)
+		return retval;
+	if (offset + count > bank->size) {
+		LOG_ERROR("pic16f1: write beyond the end of the bank");
+		return ERROR_FAIL;
+	}
+	retval = session_begin(bank, &dev);
+	if (retval != ERROR_OK)
+		return retval;
+	switch (b->role) {
+	case ROLE_FLASH:
+		retval = write_flash(bank, dev, buffer, offset, count);
+		break;
+	case ROLE_CONFIG:
+		retval = write_config(bank, dev, buffer, offset, count);
+		break;
+	case ROLE_EEPROM:
+		retval = write_eeprom(bank, dev, buffer, offset, count);
+		break;
+	}
+	int r2 = session_end(bank);
+	if (retval == ERROR_OK)
+		retval = r2;
+	if (retval == ERROR_OK && bank->num_sectors)
+		bank->sectors[0].is_erased = 0;
+	return retval;
+}
+
+static int pic16f1_info(struct flash_bank *bank, struct command_invocation *cmd)
+{
+	struct pic16f1_bank *b = bank->driver_priv;
+	const char *role[] = { "program flash", "user IDs and configuration words", "data EEPROM" };
+
+	if (!probed_device) {
+		command_print_sameline(cmd, "%s (not probed)", role[b->role]);
+		return ERROR_OK;
+	}
+	command_print_sameline(cmd, "%s, %s revision %u, %s",
+		role[b->role], probed_device->name,
+		(unsigned int)probed_rev, "erase = bulk erase of the device (see flash driver notes)");
+	return ERROR_OK;
+}
+
+static void pic16f1_free_driver_priv(struct flash_bank *bank)
+{
+	free(bank->driver_priv);
+	bank->driver_priv = NULL;
+}
+
+const struct flash_driver pic16f1_flash = {
+	.name = "pic16f1",
+	.usage = "flash bank <name> pic16f1 <base: 0x0 | 0x10000 | 0x1E000> 0 0 0 <target>",
+	.flash_bank_command = pic16f1_flash_bank_command,
+	.erase = pic16f1_erase,
+	.write = pic16f1_write,
+	.read = pic16f1_read,
+	.verify = pic16f1_verify,
+	.probe = pic16f1_probe,
+	.auto_probe = pic16f1_auto_probe,
+	.erase_check = pic16f1_erase_check,
+	.info = pic16f1_info,
+	.free_driver_priv = pic16f1_free_driver_priv,
+};
