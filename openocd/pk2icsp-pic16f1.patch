+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/*
+ * Debug executive for PIC16(L)F193x on-chip debugging.
+ *
+ * GENERATED FILE, do not edit.  It is the output of build_executive() in
+ * host/icd16f1.py (assembler: host/asm14.py) of the PICkit 2 probe project.
+ * Regenerate with:
+ *     python3 openocd/gen_pic16f1_exec.py > src/target/pic16f1_exec.h
+ * (run from the project root; the interpreter needs pyusb because
+ * host/icd16f1.py imports host/pk2probe.py).
+ *
+ * 121 words, addresses are in the 0x8000 debug/configuration space.
+ */
+
+#ifndef OPENOCD_TARGET_PIC16F1_EXEC_H
+#define OPENOCD_TARGET_PIC16F1_EXEC_H
+
+#include <stdint.h>
+
+#define PIC16F1_DEBUG_VECTOR   0x8004
+#define PIC16F1_EXEC_START     0x8010
+#define PIC16F1_EXEC_END       0x8100  /* first address past the writable area */
+#define PIC16F1_SAVE_W         0x320
+#define PIC16F1_SAVE_STATUS    0x321  /* STATUS, nibbles swapped */
+#define PIC16F1_SAVE_FSR0L     0x322  /* FSR0L, FSR0H, FSR1L, FSR1H follow */
+
+struct pic16f1_exec_word {
+	uint16_t addr;
+	uint16_t word;
+};
+
+static const struct pic16f1_exec_word pic16f1_exec[121] = {
+	{ 0x8004, 0x2810 }, { 0x8010, 0x0026 }, { 0x8011, 0x00A0 }, { 0x8012, 0x0E03 },
+	{ 0x8013, 0x00A1 }, { 0x8014, 0x0804 }, { 0x8015, 0x00A2 }, { 0x8016, 0x0805 },
+	{ 0x8017, 0x00A3 }, { 0x8018, 0x0806 }, { 0x8019, 0x00A4 }, { 0x801A, 0x0807 },
+	{ 0x801B, 0x00A5 }, { 0x801C, 0x308C }, { 0x801D, 0x0086 }, { 0x801E, 0x300F },
+	{ 0x801F, 0x0087 }, { 0x8020, 0x2069 }, { 0x8021, 0x3A01 }, { 0x8022, 0x1903 },
+	{ 0x8023, 0x2839 }, { 0x8024, 0x3A03 }, { 0x8025, 0x1903 }, { 0x8026, 0x2840 },
