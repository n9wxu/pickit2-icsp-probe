diff --git a/src/target/pic16f1.c b/src/target/pic16f1.c
new file mode 100644
index 0000000..5a4266f
--- /dev/null
+++ b/src/target/pic16f1.c
@@ -0,0 +1,1180 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+/*
+ * Target driver for Microchip PIC16(L)F193x with an on-chip debug executive,
+ * through the icsp transport (PICkit 2 ICSP probe).
+ *
+ * How the on-chip debug of these parts works is documented in docs/icd.md of
+ * the probe project; this driver is a C port of Debugger in host/icd16f1.py.
+ * Summary:
+ *
+ *  - The part is programmed with DEBUG enabled and a small debug executive
+ *    in the debug space (0x8010-0x80FF). "pic16f1 load_debug" does that.
+ *  - The core enters the executive on a hardware breakpoint, on the opcodes
+ *    0x0002/0x0003, or when ICSPCLK is driven high. The executive waits for
+ *    commands from the probe (read byte, write byte, resume).
+ *  - The target is halted when the executive waits (ICD_READY).
+ *
+ * Address convention
+ * ------------------
+ *  - Code addresses are BYTE addresses as in HEX files: byte address = 2 *
+ *    word address. Program flash is at 0, so the flash bank (base 0), the
+ *    breakpoints (bp 0x40 2 hw) and the pc register all use it. The pc
+ *    register is the byte address of the next instruction (2 * PC).
+ *  - Data memory is at 0x800000 + address, where address is the
+ *    register-file address 0x000-0xFFF (bank * 0x80 + offset) or a linear
+ *    address 0x2000 and up, as the CPU sees it.
+ *  - Program memory cannot be read from a running debug session.
+ *
+ * The hardware breakpoint halts AFTER the instruction at its address has
+ * executed (skid of one instruction). There is one breakpoint, and single
+ * step uses it. The program counter cannot be changed.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <jtag/icsp.h>
+#include <helper/binarybuffer.h>
+#include <helper/log.h>
+#include <helper/command.h>
+#include <helper/time_support.h>
+#include "target.h"
+#include "target_type.h"
+#include "register.h"
+#include "breakpoints.h"
+#include "image.h"
+#include "pic16f1_icsp.h"
+#include "pic16f1_exec.h"
+
+#define PIC16F1_MAGIC       0x50313646U
+#define DATA_BASE           0x800000
+#define DATA_SPACE          0x10000
+
+/* Executive commands */
+#define CMD_READ   0x01
+#define CMD_WRITE  0x02
+#define CMD_GO     0x03
+
+/* Debug registers (bank 31) and other places the user's state lives */
+#define REG_PCL       0xF90
+#define REG_PCH       0xF91
+#define REG_BSR       0xFE3
+#define REG_STKPTR    0xFED
+#define REG_PCLATH    0x00A
+#define BREAK_ENABLE  0x80
+
+#define SAVE_W        PIC16F1_SAVE_W
+#define SAVE_STATUS   PIC16F1_SAVE_STATUS
+#define SAVE_FSR0L    (PIC16F1_SAVE_FSR0L + 0)
+#define SAVE_FSR0H    (PIC16F1_SAVE_FSR0L + 1)
+#define SAVE_FSR1L    (PIC16F1_SAVE_FSR0L + 2)
+#define SAVE_FSR1H    (PIC16F1_SAVE_FSR0L + 3)
+
+enum pic16f1_reg {
+	R_PC, R_W, R_STATUS, R_BSR, R_PCLATH, R_FSR0, R_FSR1, R_STKPTR,
+	NUM_REGS
+};
+
+static const struct {
+	const char *name;
+	unsigned int bits;
+} reg_info[NUM_REGS] = {
+	[R_PC] = { "pc", 16 },
+	[R_W] = { "w", 8 },
+	[R_STATUS] = { "status", 8 },
+	[R_BSR] = { "bsr", 8 },
+	[R_PCLATH] = { "pclath", 8 },
+	[R_FSR0] = { "fsr0", 16 },
+	[R_FSR1] = { "fsr1", 16 },
+	[R_STKPTR] = { "stkptr", 8 },
+};
+
+struct pic16f1_common {
+	unsigned int magic;
+	struct reg_cache *cache;
+	struct breakpoint *bp;       /* the hardware breakpoint, if set */
+	bool halt_requested;
+	bool bp_armed;               /* the last resume armed the breakpoint */
+};
+
+struct pic16f1_reg_arch {
+	struct target *target;
+	enum pic16f1_reg id;
+};
+
+static struct pic16f1_common *pic(struct target *target)
+{
+	return target->arch_info;
+}
+
+/* ---- Debug link ------------------------------------------------------------ */
+
+static int link_error(const char *what)
+{
+	LOG_ERROR("pic16f1: lost contact with the debug executive (%s)", what);
+	return ERROR_TARGET_FAILURE;
+}
+
+static int exec_read_batch(const uint32_t *addrs, unsigned int n, uint8_t *out)
+{
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return link_error("flush");
+	for (unsigned int i = 0; i < n; i++) {
+		const uint8_t tx[] = { CMD_READ, addrs[i] & 0xFF, addrs[i] >> 8 };
+		retval = icsp_icd_queue(tx, sizeof(tx), 1);
+		if (retval != ERROR_OK)
+			return retval;
+	}
+	retval = icsp_flush(out, n);
+	if (retval != ERROR_OK)
+		return link_error("read");
+	return ERROR_OK;
+}
+
+static int exec_read8(uint32_t addr, uint8_t *value)
+{
+	return exec_read_batch(&addr, 1, value);
+}
+
+static int exec_write8(uint32_t addr, uint8_t value)
+{
+	const uint8_t tx[] = { CMD_WRITE, addr & 0xFF, addr >> 8, value };
+	int retval = icsp_icd_xfer(tx, sizeof(tx), NULL, 0);
+	if (retval != ERROR_OK)
+		return link_error("write");
+	return ERROR_OK;
+}
+
+static int exec_go(void)
+{
+	const uint8_t tx[] = { CMD_GO };
+	int retval = icsp_icd_xfer(tx, sizeof(tx), NULL, 0);
+	if (retval != ERROR_OK)
+		return link_error("resume");
+	return ERROR_OK;
+}
+
+static int icd_wait_ready(unsigned int timeout_ms, bool *ready)
+{
+	int64_t end = timeval_ms() + timeout_ms;
+
+	for (;;) {
+		int retval = icsp_icd_ready(ready);
+		if (retval != ERROR_OK)
+			return retval;
+		if (*ready || timeval_ms() > end)
+			return ERROR_OK;
+		alive_sleep(2);
+	}
+}
+
+static int set_breakpoint_hw(uint32_t word_addr)
+{
+	int retval = exec_write8(REG_PCL, word_addr & 0xFF);
+	if (retval == ERROR_OK)
+		retval = exec_write8(REG_PCH, ((word_addr >> 8) & 0x7F) | BREAK_ENABLE);
+	return retval;
+}
+
+static int clear_breakpoint_hw(void)
+{
+	uint8_t v;
+	int retval = exec_read8(REG_PCH, &v);
+	if (retval == ERROR_OK)
+		retval = exec_write8(REG_PCH, v & ~BREAK_ENABLE);
+	return retval;
+}
+
+/* ---- Registers --------------------------------------------------------------- */
+
+static uint8_t swap_nibbles(uint8_t v)
+{
+	return (v << 4) | (v >> 4);
+}
+
+static void reg_store(struct target *target, enum pic16f1_reg id, uint32_t value)
+{
+	struct reg *r = &pic(target)->cache->reg_list[id];
+
+	buf_set_u32(r->value, 0, r->size, value);
+	r->valid = true;
+	r->dirty = false;
+}
+
+static int read_all_regs(struct target *target)
+{
+	static const uint32_t addrs[] = {
+		REG_PCL, REG_PCH, SAVE_W, SAVE_STATUS, REG_BSR, REG_PCLATH,
+		SAVE_FSR0L, SAVE_FSR0H, SAVE_FSR1L, SAVE_FSR1H, REG_STKPTR,
+	};
+	uint8_t v[ARRAY_SIZE(addrs)];
+
+	int retval = exec_read_batch(addrs, ARRAY_SIZE(addrs), v);
+	if (retval != ERROR_OK)
+		return retval;
+	reg_store(target, R_PC, 2 * (v[0] | ((v[1] & 0x7F) << 8)));
+	reg_store(target, R_W, v[2]);
+	reg_store(target, R_STATUS, swap_nibbles(v[3]));
+	reg_store(target, R_BSR, v[4] & 0x1F);
+	reg_store(target, R_PCLATH, v[5] & 0x7F);
+	reg_store(target, R_FSR0, v[6] | (v[7] << 8));
+	reg_store(target, R_FSR1, v[8] | (v[9] << 8));
+	reg_store(target, R_STKPTR, v[10] & 0x1F);
+	return ERROR_OK;
+}
+
+static int read_pc_word(struct target *target, uint32_t *word_pc)
+{
+	struct reg *r = &pic(target)->cache->reg_list[R_PC];
+	uint8_t v[2];
+	static const uint32_t addrs[] = { REG_PCL, REG_PCH };
+
+	if (r->valid) {
+		*word_pc = buf_get_u32(r->value, 0, 16) / 2;
+		return ERROR_OK;
+	}
+	int retval = exec_read_batch(addrs, 2, v);
+	if (retval != ERROR_OK)
+		return retval;
+	*word_pc = v[0] | ((v[1] & 0x7F) << 8);
+	reg_store(target, R_PC, 2 * *word_pc);
+	return ERROR_OK;
+}
+
+static int pic16f1_get_reg(struct reg *reg)
+{
+	struct pic16f1_reg_arch *a = reg->arch_info;
+	struct target *target = a->target;
+
+	if (target->state != TARGET_HALTED)
+		return ERROR_TARGET_NOT_HALTED;
+	if (reg->valid)
+		return ERROR_OK;
+	if (a->id == R_PC) {
+		uint32_t pc;
+		return read_pc_word(target, &pc);
+	}
+	return read_all_regs(target);
+}
+
+static int pic16f1_set_reg(struct reg *reg, uint8_t *buf)
+{
+	struct pic16f1_reg_arch *a = reg->arch_info;
+	struct target *target = a->target;
+	uint32_t v = buf_get_u32(buf, 0, reg->size);
+	int retval = ERROR_OK;
+
+	if (target->state != TARGET_HALTED)
+		return ERROR_TARGET_NOT_HALTED;
+
+	switch (a->id) {
+	case R_PC:
+		LOG_ERROR("pic16f1: the program counter of a halted target cannot be changed");
+		return ERROR_FAIL;
+	case R_W:
+		retval = exec_write8(SAVE_W, v);
+		break;
+	case R_STATUS:
+		retval = exec_write8(SAVE_STATUS, swap_nibbles(v));
+		break;
+	case R_BSR:
+		retval = exec_write8(REG_BSR, v & 0x1F);
+		break;
+	case R_PCLATH:
+		retval = exec_write8(REG_PCLATH, v & 0x7F);
+		break;
+	case R_FSR0:
+		retval = exec_write8(SAVE_FSR0L, v & 0xFF);
+		if (retval == ERROR_OK)
+			retval = exec_write8(SAVE_FSR0H, v >> 8);
+		break;
+	case R_FSR1:
+		retval = exec_write8(SAVE_FSR1L, v & 0xFF);
+		if (retval == ERROR_OK)
+			retval = exec_write8(SAVE_FSR1H, v >> 8);
+		break;
+	case R_STKPTR:
+		retval = exec_write8(REG_STKPTR, v & 0x1F);
+		break;
+	default:
+		return ERROR_FAIL;
+	}
+	if (retval != ERROR_OK)
+		return retval;
+	buf_set_u32(reg->value, 0, reg->size, v);
+	reg->valid = true;
+	reg->dirty = false;
+	return ERROR_OK;
+}
+
+static const struct reg_arch_type pic16f1_reg_type = {
+	.get = pic16f1_get_reg,
+	.set = pic16f1_set_reg,
+};
+
+static struct reg_cache *pic16f1_build_reg_cache(struct target *target)
+{
+	struct pic16f1_common *p = pic(target);
+	struct reg_cache **cache_p = register_get_last_cache_p(&target->reg_cache);
+	struct reg_cache *cache = calloc(1, sizeof(*cache));
+	struct reg *list = calloc(NUM_REGS, sizeof(*list));
+	struct pic16f1_reg_arch *arch = calloc(NUM_REGS, sizeof(*arch));
+
+	if (!cache || !list || !arch)
+		return NULL;
+	cache->name = "pic16f1 registers";
+	cache->reg_list = list;
+	cache->num_regs = NUM_REGS;
+	*cache_p = cache;
+	p->cache = cache;
+
+	for (unsigned int i = 0; i < NUM_REGS; i++) {
+		arch[i].target = target;
+		arch[i].id = i;
+		list[i].name = reg_info[i].name;
+		list[i].size = reg_info[i].bits;
+		list[i].value = calloc(1, 4);
+		list[i].valid = false;
+		list[i].dirty = false;
+		list[i].exist = true;
+		list[i].type = &pic16f1_reg_type;
+		list[i].arch_info = &arch[i];
+		list[i].group = "general";
+		list[i].number = i;
+		list[i].reg_data_type = calloc(1, sizeof(struct reg_data_type));
+		if (list[i].reg_data_type)
+			list[i].reg_data_type->type = reg_info[i].bits == 16 ? REG_TYPE_UINT16 : REG_TYPE_UINT8;
+		list[i].feature = calloc(1, sizeof(struct reg_feature));
+		if (list[i].feature)
+			list[i].feature->name = "org.gnu.gdb.pic16f1.core";
+	}
+	return cache;
+}
+
+static int pic16f1_get_gdb_reg_list(struct target *target, struct reg **reg_list[],
+		int *reg_list_size, enum target_register_class reg_class)
+{
+	struct pic16f1_common *p = pic(target);
+
+	*reg_list_size = NUM_REGS;
+	*reg_list = malloc(sizeof(struct reg *) * NUM_REGS);
+	if (!*reg_list)
+		return ERROR_FAIL;
+	for (unsigned int i = 0; i < NUM_REGS; i++)
+		(*reg_list)[i] = &p->cache->reg_list[i];
+	return ERROR_OK;
+}
+
+/* ---- State ------------------------------------------------------------------- */
+
+static void debug_entry(struct target *target, enum target_debug_reason reason)
+{
+	register_cache_invalidate(pic(target)->cache);
+	target->state = TARGET_HALTED;
+	target->debug_reason = reason;
+	/* fill the register cache now, so that "reg" shows values */
+	if (read_all_regs(target) != ERROR_OK)
+		LOG_WARNING("pic16f1: could not read the registers");
+}
+
+void pic16f1_target_link_lost(struct target *target)
+{
+	if (!target || target->type->name == NULL || strcmp(target->type->name, "pic16f1"))
+		return;
+	register_cache_invalidate(pic(target)->cache);
+	target->state = TARGET_UNKNOWN;
+	pic(target)->bp_armed = false;
+}
+
+static int pic16f1_poll(struct target *target)
+{
+	struct pic16f1_common *p = pic(target);
+	bool ready;
+
+	int retval = icsp_icd_ready(&ready);
+	if (retval != ERROR_OK)
+		return ERROR_OK;   /* try again at the next poll */
+
+	if (ready) {
+		if (target->state != TARGET_HALTED) {
+			enum target_debug_reason reason = p->bp_armed ?
+				DBG_REASON_BREAKPOINT : DBG_REASON_DBGRQ;
+			bool was_debug_running = target->state == TARGET_DEBUG_RUNNING;
+
+			p->bp_armed = false;
+			p->halt_requested = false;
+			debug_entry(target, reason);
+			target_call_event_callbacks(target, was_debug_running ?
+				TARGET_EVENT_DEBUG_HALTED : TARGET_EVENT_HALTED);
+		}
+	} else if (target->state != TARGET_RUNNING && target->state != TARGET_DEBUG_RUNNING) {
+		/* not waiting for commands: user code runs (or the target is not
+		 * programmed for debugging) */
+		if (target->state == TARGET_HALTED)
+			LOG_WARNING("pic16f1: the target left the halted state by itself");
+		target->state = TARGET_RUNNING;
+		target->debug_reason = DBG_REASON_NOTHALTED;
+		register_cache_invalidate(p->cache);
+	}
+	return ERROR_OK;
+}
+
+static int pic16f1_halt(struct target *target)
+{
+	struct pic16f1_common *p = pic(target);
+	bool ready;
+
+	if (target->state == TARGET_HALTED)
+		return ERROR_OK;
+	if (target->state == TARGET_UNKNOWN)
+		pic16f1_poll(target);
+	if (target->state == TARGET_HALTED)
+		return ERROR_OK;
+
+	/* ICSPCLK high for 200 us, then released */
+	icsp_pins(ICSP_PIN_CLK | ICSP_PIN_DAT_IN);
+	icsp_delay_us(200);
+	icsp_pins(ICSP_PINS_IDLE);
+	int retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = icd_wait_ready(500, &ready);
+	if (retval != ERROR_OK)
+		return retval;
+	if (!ready) {
+		LOG_ERROR("pic16f1: the target did not halt; is it programmed for debugging "
+			"(pic16f1 load_debug) and powered?");
+		return ERROR_TARGET_FAILURE;
+	}
+	p->bp_armed = false;
+	debug_entry(target, DBG_REASON_DBGRQ);
+	target_call_event_callbacks(target, TARGET_EVENT_HALTED);
+	return ERROR_OK;
+}
+
+static int resume_common(struct target *target, bool debug_execution)
+{
+	struct pic16f1_common *p = pic(target);
+	int retval;
+
+	if (p->bp) {
+		retval = set_breakpoint_hw(p->bp->address / 2);
+		p->bp_armed = true;
+	} else {
+		retval = clear_breakpoint_hw();
+		p->bp_armed = false;
+	}
+	if (retval == ERROR_OK)
+		retval = exec_go();
+	if (retval != ERROR_OK)
+		return retval;
+
+	register_cache_invalidate(p->cache);
+	target->state = debug_execution ? TARGET_DEBUG_RUNNING : TARGET_RUNNING;
+	target->debug_reason = DBG_REASON_NOTHALTED;
+	return ERROR_OK;
+}
+
+static int pic16f1_resume(struct target *target, int current, target_addr_t address,
+		int handle_breakpoints, int debug_execution)
+{
+	if (target->state != TARGET_HALTED) {
+		LOG_WARNING("pic16f1: target not halted");
+		return ERROR_TARGET_NOT_HALTED;
+	}
+	if (!current) {
+		LOG_ERROR("pic16f1: the program counter cannot be changed, resume from the current pc");
+		return ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
+	}
+
+	int retval = resume_common(target, debug_execution);
+	if (retval != ERROR_OK)
+		return retval;
+	target_call_event_callbacks(target, debug_execution ?
+		TARGET_EVENT_DEBUG_RESUMED : TARGET_EVENT_RESUMED);
+	return ERROR_OK;
+}
+
+static int pic16f1_step(struct target *target, int current, target_addr_t address,
+		int handle_breakpoints)
+{
+	struct pic16f1_common *p = pic(target);
+	uint32_t pc;
+	bool ready;
+
+	if (target->state != TARGET_HALTED) {
+		LOG_WARNING("pic16f1: target not halted");
+		return ERROR_TARGET_NOT_HALTED;
+	}
+	if (!current) {
+		LOG_ERROR("pic16f1: the program counter cannot be changed, step from the current pc");
+		return ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
+	}
+
+	int retval = read_pc_word(target, &pc);
+	if (retval != ERROR_OK)
+		return retval;
+
+	/* A breakpoint on the current instruction: exactly one instruction runs */
+	retval = set_breakpoint_hw(pc);
+	if (retval == ERROR_OK)
+		retval = exec_go();
+	if (retval != ERROR_OK)
+		return retval;
+
+	register_cache_invalidate(p->cache);
+	target->state = TARGET_RUNNING;
+	target_call_event_callbacks(target, TARGET_EVENT_RESUMED);
+
+	retval = icd_wait_ready(1000, &ready);
+	if (retval != ERROR_OK)
+		return retval;
+	if (!ready) {
+		LOG_ERROR("pic16f1: the target did not come back from a single step");
+		return ERROR_TARGET_FAILURE;
+	}
+	p->bp_armed = false;
+	debug_entry(target, DBG_REASON_SINGLESTEP);
+	target_call_event_callbacks(target, TARGET_EVENT_HALTED);
+	return ERROR_OK;
+}
+
+/*
+ * Reset, as Debugger.reset(): MCLR has no effect while the executive runs, so
+ * the target is resumed with the breakpoint on address 0 and then reset; the
+ * breakpoint register survives the reset. If MCLR is not a reset input (the
+ * configuration words can make it a digital input) and the probe powers the
+ * target, the target is power cycled instead, which arms the same breakpoint.
+ */
+static int reset_to_vector(struct target *target)
+{
+	struct pic16f1_common *p = pic(target);
+	const struct icsp_config *c = icsp_get_config();
+	bool ready;
+	int retval;
+
+	if (target->state != TARGET_HALTED) {
+		retval = pic16f1_halt(target);
+		if (retval != ERROR_OK)
+			return retval;
+	}
+	retval = set_breakpoint_hw(0);
+	if (retval == ERROR_OK)
+		retval = exec_go();
+	if (retval != ERROR_OK)
+		return retval;
+	register_cache_invalidate(p->cache);
+	target->state = TARGET_RESET;
+
+	/*
+	 * The executive needs time to restore the registers and leave debug
+	 * mode, in which MCLR is ignored: about 0.3 ms at the 500 kHz reset
+	 * clock, more on a 31 kHz clock.
+	 */
+	icsp_delay_ms(10);
+	icsp_mclr(ICSP_MCLR_GROUND);
+	icsp_delay_ms(2);
+	icsp_pins(ICSP_PINS_IDLE);
+	icsp_mclr(ICSP_MCLR_RELEASE);
+	retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+
+	retval = icd_wait_ready(500, &ready);
+	if (retval == ERROR_OK && ready) {
+		uint32_t pc;
+		register_cache_invalidate(p->cache);
+		retval = read_pc_word(target, &pc);
+		if (retval == ERROR_OK && pc <= 1) {
+			exec_write8(REG_BSR, 0);   /* the saved copy is not cleared by the reset */
+			return ERROR_OK;
+		}
+	}
+
+	if (!c || !c->power) {
+		LOG_ERROR("pic16f1: the target did not stop after an MCLR reset");
+		return ERROR_TARGET_FAILURE;
+	}
+	LOG_INFO("pic16f1: MCLR reset had no effect, power cycling the target");
+	icsp_pins(ICSP_PINS_IDLE);
+	icsp_vdd_mode(ICSP_VDD_DISCHARGE);
+	icsp_delay_ms(100);
+	icsp_vdd_mode(ICSP_VDD_OFF);
+	icsp_vdd_mode(ICSP_VDD_ON);
+	retval = icsp_flush(NULL, 0);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = icd_wait_ready(1000, &ready);
+	if (retval != ERROR_OK)
+		return retval;
+	if (!ready) {
+		LOG_ERROR("pic16f1: the target did not stop after a power cycle");
+		return ERROR_TARGET_FAILURE;
+	}
+	return ERROR_OK;
+}
+
+static int pic16f1_assert_reset(struct target *target)
+{
+	struct pic16f1_common *p = pic(target);
+
+	/* the debug registers keep a stale breakpoint over a reset; forget ours */
+	int retval = reset_to_vector(target);
+	if (retval != ERROR_OK) {
+		target->state = TARGET_UNKNOWN;
+		return retval;
+	}
+	p->bp_armed = false;
+	debug_entry(target, DBG_REASON_DBGRQ);
+
+	if (!target->reset_halt) {
+		/* reset run: let it go from the reset vector */
+		retval = resume_common(target, false);
+		if (retval != ERROR_OK)
+			return retval;
+	}
+	return ERROR_OK;
+}
+
+static int pic16f1_deassert_reset(struct target *target)
+{
+	if (target->reset_halt && target->state == TARGET_HALTED)
+		target_call_event_callbacks(target, TARGET_EVENT_HALTED);
+	return ERROR_OK;
+}
+
+/* ---- Breakpoints --------------------------------------------------------------- */
+
+static int pic16f1_add_breakpoint(struct target *target, struct breakpoint *breakpoint)
+{
+	struct pic16f1_common *p = pic(target);
+
+	if (target->state != TARGET_HALTED)
+		return ERROR_TARGET_NOT_HALTED;
+	if (breakpoint->type != BKPT_HARD) {
+		LOG_ERROR("pic16f1: only a hardware breakpoint is available (bp <addr> 2 hw; "
+			"for gdb use 'gdb_breakpoint_override hard')");
+		return ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
+	}
+	if (breakpoint->address & 1 || breakpoint->address >= 0x10000) {
+		LOG_ERROR("pic16f1: breakpoint address must be an even byte address (2 * word address) below 0x10000");
+		return ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
+	}
+	if (p->bp) {
+		LOG_ERROR("pic16f1: there is only one hardware breakpoint");
+		return ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
+	}
+	p->bp = breakpoint;
+	breakpoint->is_set = true;
+	LOG_INFO("pic16f1: the target halts AFTER the instruction at 0x%" TARGET_PRIxADDR
+		" has executed", breakpoint->address);
+	return ERROR_OK;
+}
+
+static int pic16f1_remove_breakpoint(struct target *target, struct breakpoint *breakpoint)
+{
+	struct pic16f1_common *p = pic(target);
+
+	if (p->bp == breakpoint)
+		p->bp = NULL;
+	breakpoint->is_set = false;
+	return ERROR_OK;
+}
+
+/* ---- Memory ------------------------------------------------------------------- */
+
+/* Where the user's value of a core register lives while halted (Debugger._map) */
+static uint32_t map_addr(uint32_t addr)
+{
+	if (addr < 0x1000) {
+		switch (addr & 0x7F) {
+		case 0x04: return SAVE_FSR0L;
+		case 0x05: return SAVE_FSR0H;
+		case 0x06: return SAVE_FSR1L;
+		case 0x07: return SAVE_FSR1H;
+		case 0x08: return REG_BSR;
+		case 0x09: return SAVE_W;
+		default:
+			if ((addr & 0x7F) < 0x0C)
+				return addr & 0x7F;   /* other core registers: any bank will do */
+		}
+	}
+	return addr;
+}
+
+static int check_data_access(struct target *target, target_addr_t address, uint32_t bytes)
+{
+	if (target->state != TARGET_HALTED) {
+		LOG_ERROR("pic16f1: target not halted");
+		return ERROR_TARGET_NOT_HALTED;
+	}
+	if (address < DATA_BASE) {
+		LOG_ERROR("pic16f1: address 0x%" TARGET_PRIxADDR " is program memory, which cannot "
+			"be accessed during a debug session; data memory is at 0x%x + address "
+			"(use 'flash read_bank' for program memory)", address, DATA_BASE);
+		return ERROR_FAIL;
+	}
+	if (address - DATA_BASE + bytes > DATA_SPACE) {
+		LOG_ERROR("pic16f1: data address out of range");
+		return ERROR_FAIL;
+	}
+	return ERROR_OK;
+}
+
+static int pic16f1_read_memory(struct target *target, target_addr_t address,
+		uint32_t size, uint32_t count, uint8_t *buffer)
+{
+	uint32_t total = size * count;
+	int retval = check_data_access(target, address, total);
+	if (retval != ERROR_OK)
+		return retval;
+
+	uint32_t base = address - DATA_BASE;
+	uint32_t pc_word = 0;
+	bool have_pc = false;
+
+	for (uint32_t done = 0; done < total;) {
+		uint32_t n = MIN(total - done, 24U);
+		uint32_t addrs[24];
+		uint8_t v[24];
+
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t a = base + done + i;
+			if (a < 0x1000 && (a & 0x7F) == 0x03)
+				addrs[i] = SAVE_STATUS;
+			else if (a < 0x1000 && (a & 0x7F) == 0x02)
+				addrs[i] = REG_PCL;       /* the PC at the halt, not the shadow of PCL */
+			else
+				addrs[i] = map_addr(a);
+		}
+		retval = exec_read_batch(addrs, n, v);
+		if (retval != ERROR_OK)
+			return retval;
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t a = base + done + i;
+			if (a < 0x1000 && (a & 0x7F) == 0x03) {
+				v[i] = swap_nibbles(v[i]);
+			} else if (a < 0x1000 && (a & 0x7F) == 0x02) {
+				if (!have_pc) {
+					retval = read_pc_word(target, &pc_word);
+					if (retval != ERROR_OK)
+						return retval;
+					have_pc = true;
+				}
+				v[i] = pc_word & 0xFF;
+			}
+			buffer[done + i] = v[i];
+		}
+		done += n;
+	}
+	return ERROR_OK;
+}
+
+static int pic16f1_write_memory(struct target *target, target_addr_t address,
+		uint32_t size, uint32_t count, const uint8_t *buffer)
+{
+	uint32_t total = size * count;
+	int retval = check_data_access(target, address, total);
+	if (retval != ERROR_OK)
+		return retval;
+
+	uint32_t base = address - DATA_BASE;
+
+	for (uint32_t i = 0; i < total; i++) {
+		uint32_t a = base + i;
+		if (a < 0x1000 && (a & 0x7F) == 0x02) {
+			LOG_ERROR("pic16f1: the program counter of a halted target cannot be changed");
+			return ERROR_FAIL;
+		}
+	}
+	for (uint32_t done = 0; done < total;) {
+		uint32_t n = MIN(total - done, 7U);
+
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t a = base + done + i;
+			uint8_t value = buffer[done + i];
+			uint32_t dst;
+
+			if (a < 0x1000 && (a & 0x7F) == 0x03) {
+				dst = SAVE_STATUS;
+				value = swap_nibbles(value);
+			} else {
+				dst = map_addr(a);
+			}
+			const uint8_t tx[] = { CMD_WRITE, dst & 0xFF, dst >> 8, value };
+			retval = icsp_icd_queue(tx, sizeof(tx), 0);
+			if (retval != ERROR_OK)
+				return retval;
+		}
+		retval = icsp_flush(NULL, 0);
+		if (retval != ERROR_OK)
+			return link_error("write");
+		done += n;
+	}
+	/* cached copies of core registers may have changed */
+	for (uint32_t i = 0; i < total; i++) {
+		uint32_t a = base + i;
+		if ((a < 0x1000 && (a & 0x7F) < 0x0C) || (a >= 0x320 && a < 0x330) ||
+				a == REG_PCL || a == REG_PCH || a == REG_BSR || a == REG_STKPTR) {
+			register_cache_invalidate(pic(target)->cache);
+			if (read_all_regs(target) != ERROR_OK)
+				LOG_WARNING("pic16f1: could not read the registers");
+			break;
+		}
+	}
+	return ERROR_OK;
+}
+
+/* ---- Debug load ---------------------------------------------------------------- */
+
+static int write_sparse_config(const struct pic16f1_exec_word *w, unsigned int n)
+{
+	unsigned int i = 0;
+
+	while (i < n) {
+		uint16_t run[256];
+		unsigned int len = 0;
+		uint32_t start = w[i].addr;
+
+		while (i < n && w[i].addr == start + len && len < ARRAY_SIZE(run))
+			run[len++] = w[i++].word;
+		int retval = pic16f1_write_config_words(start, run, len);
+		if (retval != ERROR_OK)
+			return retval;
+	}
+	return ERROR_OK;
+}
+
+static int erase_exec_rows(void)
+{
+	for (uint32_t row = 0x8020; row < PIC16F1_EXEC_END; row += 0x20) {
+		int retval = pic16f1_row_erase(row);
+		if (retval != ERROR_OK)
+			return retval;
+	}
+	return ERROR_OK;
+}
+
+static int verify_words(uint32_t addr, const uint16_t *want, unsigned int count, const char *what)
+{
+	uint16_t *back = malloc(count * sizeof(uint16_t));
+	int errors = 0;
+
+	if (!back)
+		return ERROR_FAIL;
+	int retval = pic16f1_read_words(addr, count, back);
+	if (retval == ERROR_OK) {
+		for (unsigned int i = 0; i < count; i++) {
+			if (back[i] != want[i]) {
+				if (errors++ < 5)
+					LOG_ERROR("pic16f1: %s 0x%04" PRIx32 ": wrote 0x%04x, read 0x%04x",
+						what, addr + i, want[i], back[i]);
+			}
+		}
+		if (errors)
+			retval = ERROR_FAIL;
+	}
+	free(back);
+	return retval;
+}
+
+static int do_load_debug(struct target *target, struct image *image)
+{
+	const struct pic16f1_device *dev;
+	struct pic16f1_image img;
+	int retval;
+
+	retval = pic16f1_connect(&dev, NULL, NULL);
+	if (retval != ERROR_OK)
+		return retval;
+	if (!dev->debug) {
+		LOG_ERROR("pic16f1: debugging is only supported for the PIC16(L)F193x, found %s", dev->name);
+		pic16f1_disconnect();
+		return ERROR_FAIL;
+	}
+	LOG_INFO("pic16f1: loading %s for debugging", dev->name);
+
+	retval = pic16f1_image_split(image, dev, &img);
+	if (retval != ERROR_OK) {
+		pic16f1_disconnect();
+		return retval;
+	}
+	if (!img.cfg_present[PIC16F1_CONFIG2_ADDR - 0x8000]) {
+		LOG_ERROR("pic16f1: the image has no configuration words");
+		retval = ERROR_FAIL;
+		goto done;
+	}
+	img.cfg[PIC16F1_CONFIG2_ADDR - 0x8000] &= ~PIC16F1_CONFIG2_DEBUG;
+
+	retval = pic16f1_bulk_erase(dev);
+	if (retval == ERROR_OK)
+		retval = erase_exec_rows();
+	if (retval != ERROR_OK)
+		goto done;
+
+	/* flash up to the last used latch */
+	uint32_t top = 0;
+	for (uint32_t i = 0; i < dev->flash_words; i++)
+		if (img.flash[i] != PIC16F1_BLANK)
+			top = i + 1;
+	top = (top + dev->latches - 1) / dev->latches * dev->latches;
+	if (top) {
+		retval = pic16f1_write_flash(dev, 0, img.flash, top);
+		if (retval != ERROR_OK)
+			goto done;
+	}
+	if (img.has_ee) {
+		retval = pic16f1_write_eeprom(0, img.ee, dev->eeprom);
+		if (retval != ERROR_OK)
+			goto done;
+	}
+	/* user IDs */
+	for (unsigned int i = 0; i < PIC16F1_USERID_WORDS && retval == ERROR_OK; i++) {
+		if (img.cfg_present[i])
+			retval = pic16f1_write_config_words(PIC16F1_USERID_ADDR + i, &img.cfg[i], 1);
+	}
+	if (retval != ERROR_OK)
+		goto done;
+
+	/* verify what is there so far */
+	if (top)
+		retval = verify_words(0, img.flash, top, "flash");
+	for (unsigned int i = 0; i < PIC16F1_USERID_WORDS && retval == ERROR_OK; i++)
+		if (img.cfg_present[i])
+			retval = verify_words(PIC16F1_USERID_ADDR + i, &img.cfg[i], 1, "user id");
+	if (retval == ERROR_OK && img.has_ee) {
+		uint8_t back[PIC16F1_MAX_EEPROM];
+		retval = pic16f1_read_eeprom(dev->eeprom, back);
+		if (retval == ERROR_OK && memcmp(back, img.ee, dev->eeprom)) {
+			LOG_ERROR("pic16f1: EEPROM verify failed");
+			retval = ERROR_FAIL;
+		}
+	}
+	if (retval != ERROR_OK)
+		goto done;
+
+	/* the debug executive */
+	retval = write_sparse_config(pic16f1_exec, PIC16F1_EXEC_WORDS);
+	if (retval == ERROR_OK) {
+		uint32_t lo = pic16f1_exec[0].addr, hi = pic16f1_exec[PIC16F1_EXEC_WORDS - 1].addr;
+		uint16_t *back = malloc((hi - lo + 1) * sizeof(uint16_t));
+		if (!back) {
+			retval = ERROR_FAIL;
+			goto done;
+		}
+		retval = pic16f1_read_words(lo, hi - lo + 1, back);
+		for (unsigned int i = 0; retval == ERROR_OK && i < PIC16F1_EXEC_WORDS; i++) {
+			if (back[pic16f1_exec[i].addr - lo] != pic16f1_exec[i].word) {
+				LOG_ERROR("pic16f1: executive 0x%04x: wrote 0x%04x, read 0x%04x",
+					pic16f1_exec[i].addr, pic16f1_exec[i].word,
+					back[pic16f1_exec[i].addr - lo]);
+				retval = ERROR_FAIL;
+			}
+		}
+		free(back);
+	}
+	if (retval != ERROR_OK)
+		goto done;
+
+	/* configuration words last: DEBUG is enabled by this */
+	for (unsigned int i = 0; i < dev->config_words && retval == ERROR_OK; i++) {
+		uint32_t idx = PIC16F1_CONFIG_ADDR - 0x8000 + i;
+		if (!img.cfg_present[idx])
+			continue;
+		retval = pic16f1_write_config_words(0x8000 + idx, &img.cfg[idx], 1);
+		if (retval == ERROR_OK)
+			retval = verify_words(0x8000 + idx, &img.cfg[idx], 1, "config");
+	}
+done:
+	pic16f1_image_free(&img);
+	int r2 = pic16f1_disconnect();   /* the target leaves reset */
+	return retval != ERROR_OK ? retval : r2;
+}
+
+COMMAND_HANDLER(handle_pic16f1_load_debug_command)
+{
+	struct target *target = get_current_target(CMD_CTX);
+	struct image image;
+
+	if (CMD_ARGC != 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	int retval = image_open(&image, CMD_ARGV[0], "ihex");
+	if (retval != ERROR_OK)
+		return retval;
+
+	pic16f1_target_link_lost(target);
+	retval = do_load_debug(target, &image);
+	image_close(&image);
+	if (retval != ERROR_OK) {
+		command_print(CMD, "pic16f1: load_debug failed");
+		return retval;
+	}
+
+	/* The part runs; with DEBUG enabled a power-on stops it at the reset
+	 * vector. */
+	bool ready = false;
+	retval = icd_wait_ready(500, &ready);
+	if (retval == ERROR_OK && !ready) {
+		pic16f1_target_link_lost(target);
+		retval = pic16f1_halt(target);
+		if (retval != ERROR_OK)
+			return retval;
+	} else {
+		pic16f1_poll(target);
+	}
+	command_print(CMD, "target programmed for debugging, state: %s",
+		target_state_name(target));
+	return ERROR_OK;
+}
+
+COMMAND_HANDLER(handle_pic16f1_unload_debug_command)
+{
+	struct target *target = get_current_target(CMD_CTX);
+	const struct pic16f1_device *dev;
+
+	if (CMD_ARGC != 0)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	pic16f1_target_link_lost(target);
+	int retval = pic16f1_connect(&dev, NULL, NULL);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = pic16f1_bulk_erase(dev);
+	if (retval == ERROR_OK)
+		retval = erase_exec_rows();
+	int r2 = pic16f1_disconnect();
+	if (retval == ERROR_OK)
+		retval = r2;
+	if (retval != ERROR_OK)
+		return retval;
+	command_print(CMD, "%s erased, debug executive removed", dev->name);
+	return ERROR_OK;
+}
+
+static const struct command_registration pic16f1_exec_command_handlers[] = {
+	{
+		.name = "load_debug",
+		.handler = handle_pic16f1_load_debug_command,
+		.mode = COMMAND_EXEC,
+		.help = "bulk erase, program an Intel HEX image together with the debug "
+			"executive and DEBUG enabled, release reset; the target ends halted "
+			"at the reset vector",
+		.usage = "hexfile",
+	},
+	{
+		.name = "unload_debug",
+		.handler = handle_pic16f1_unload_debug_command,
+		.mode = COMMAND_EXEC,
+		.help = "bulk erase the device and erase the debug executive rows",
+		.usage = "",
+	},
+	COMMAND_REGISTRATION_DONE
+};
+
+static const struct command_registration pic16f1_command_handlers[] = {
+	{
+		.name = "pic16f1",
+		.mode = COMMAND_ANY,
+		.help = "PIC16F1 target commands",
+		.usage = "",
+		.chain = pic16f1_exec_command_handlers,
+	},
+	COMMAND_REGISTRATION_DONE
+};
+
+/* ---- Target type ---------------------------------------------------------------- */
+
+static int pic16f1_target_create(struct target *target, Jim_Interp *interp)
+{
+	struct pic16f1_common *p = calloc(1, sizeof(*p));
+
+	if (!p)
+		return ERROR_FAIL;
+	p->magic = PIC16F1_MAGIC;
+	target->arch_info = p;
+	target->endianness = TARGET_LITTLE_ENDIAN;
+	return ERROR_OK;
+}
+
+static int pic16f1_init_target(struct command_context *cmd_ctx, struct target *target)
+{
+	if (!pic16f1_build_reg_cache(target))
+		return ERROR_FAIL;
+	return ERROR_OK;
+}
+
+static void pic16f1_deinit_target(struct target *target)
+{
+	struct pic16f1_common *p = pic(target);
+
+	if (!p)
+		return;
+	if (p->cache) {
+		for (unsigned int i = 0; i < NUM_REGS; i++) {
+			free(p->cache->reg_list[i].value);
+			free(p->cache->reg_list[i].reg_data_type);
+			free(p->cache->reg_list[i].feature);
+		}
+		free(p->cache->reg_list[0].arch_info);
+		free(p->cache->reg_list);
+		free(p->cache);
+	}
+	free(p);
+	target->arch_info = NULL;
+}
+
+static int pic16f1_examine(struct target *target)
+{
+	if (!target_was_examined(target)) {
+		bool ready;
+		int retval = icsp_icd_ready(&ready);
+		if (retval != ERROR_OK)
+			return retval;
+		target_set_examined(target);
+		LOG_INFO("pic16f1: debug link %s", ready ? "ready, target halted" : "idle, target running (or not programmed for debugging)");
+	}
+	return ERROR_OK;
+}
+
+static int pic16f1_arch_state(struct target *target)
+{
+	struct reg *pc = &pic(target)->cache->reg_list[R_PC];
+
+	if (target->state == TARGET_HALTED && pc->valid)
+		LOG_USER("target halted due to %s, pc 0x%04" PRIx32 " (word address 0x%04" PRIx32 ")",
+			debug_reason_name(target),
+			buf_get_u32(pc->value, 0, 16), buf_get_u32(pc->value, 0, 16) / 2);
+	return ERROR_OK;
+}
+
+struct target_type pic16f1_target = {
+	.name = "pic16f1",
+
+	.poll = pic16f1_poll,
+	.arch_state = pic16f1_arch_state,
+
+	.halt = pic16f1_halt,
+	.resume = pic16f1_resume,
+	.step = pic16f1_step,
+
+	.assert_reset = pic16f1_assert_reset,
+	.deassert_reset = pic16f1_deassert_reset,
+
+	.get_gdb_reg_list = pic16f1_get_gdb_reg_list,
+
+	.read_memory = pic16f1_read_memory,
+	.write_memory = pic16f1_write_memory,
+
+	.add_breakpoint = pic16f1_add_breakpoint,
+	.remove_breakpoint = pic16f1_remove_breakpoint,
+
+	.commands = pic16f1_command_handlers,
+	.target_create = pic16f1_target_create,
+	.init_target = pic16f1_init_target,
+	.deinit_target = pic16f1_deinit_target,
+	.examine = pic16f1_examine,
+};
